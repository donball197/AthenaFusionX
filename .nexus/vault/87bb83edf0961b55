// src/task_manager.rs — v5.8 [FORMAT_CORRECTION + DEADLOCK_GUARD + PUSH_FIX + TRUNCATION]
use crate::{
    agent_protocol::AgentAction,
    cli,
    json_parser,
    orchestrator::Orchestrator,
    memory::MemoryPalace,
    server::VmoState,
    distributed_scheduler::DistributedScheduler,
    executor::RoboticExecutor,
    logic_engine::LogicEngine,
};
use reqwest::Client;
use std::sync::Arc;
use tokio::sync::{broadcast, Mutex};
use tracing::{info, error, warn};

const FORMAT_CORRECTION: &str = "\
[FORMAT_VIOLATION] Your previous response was REJECTED — it contained prose \
before the JSON array. You MUST output ONLY a raw JSON array. \
Start your response with `[` and end with `]`. No reasoning text outside JSON. \
Retry the same action now.";

pub async fn send_task(
    orchestrator: Arc<Orchestrator>,
    client: &Client,
    api_key: &str,
    raw_directive: &str,
    memory: Arc<Mutex<MemoryPalace>>,
    vmo_state: Arc<Mutex<VmoState>>,
    tx: broadcast::Sender<String>,
    dist: Arc<DistributedScheduler>,
) -> String {
    let mut session_obs: Vec<String> = vec![];
    let mut turn = 0;
    let mut consecutive_fractures: usize = 0;
    const MAX_TURNS: usize = 12;
    const MAX_CONSECUTIVE_FRACTURES: usize = 3;
    const OBS_WINDOW: usize = 5;
    const MAX_OBS_CHARS: usize = 2500;

    let execution_law = cli::get_execution_law_v6().await;
    let mut executor = RoboticExecutor::new(api_key.to_string(), tx.clone());

    while turn < MAX_TURNS {
        turn += 1;
        info!("=== Turn {} started ===", turn);

        // ── Deadlock guard ────────────────────────────────────────────────
        if LogicEngine::detect_deadlock(&session_obs) {
            warn!("[DEADLOCK] Cortex Loop detected. Aborting mission.");
            let _ = tx.send(
                serde_json::json!({"type": "TASK_STATUS", "payload": "DEADLOCK_ABORT"}).to_string()
            );
            break;
        }

        // Early abort on sustained fracture storm
        if consecutive_fractures >= MAX_CONSECUTIVE_FRACTURES {
            warn!("[FRACTURE_STORM] {} consecutive parser failures. Aborting.", consecutive_fractures);
            let _ = tx.send(
                serde_json::json!({"type": "TASK_STATUS", "payload": "FRACTURE_STORM_ABORT"}).to_string()
            );
            break;
        }

        // ── Build observation window ───────────────────────────────────────
        let window = session_obs.iter().rev().take(OBS_WINDOW).rev().cloned().collect::<Vec<_>>();

        let ctx = crate::neural_agent::ContextPacket {
            system_prompt: Some(execution_law.clone()),
            recent_logs: window,
            ..Default::default()
        };

        // ── Uplink ────────────────────────────────────────────────────────
        let response = match orchestrator.run(
            raw_directive.to_string(), ctx, client, api_key, Some(tx.clone())
        ).await {
            Ok(resp) => resp,
            Err(e) => { error!("Uplink failed: {}", e); break; }
        };

        // ── Parse ─────────────────────────────────────────────────────────
        match json_parser::extract_actions(&response) {
            Ok(actions) => {
                if actions.is_empty() { break; }

                // Reset fracture counter on any successful parse
                consecutive_fractures = 0;

                match executor.execute_handle(
                    actions.clone(), memory.clone(), vmo_state.clone(), dist.clone()
                ).await {
                    Ok(observations) => {
                        for obs in observations {
                            // ⚡ SUTURE: Harsh truncation for individual long outputs
                            let clean_obs = if obs.len() > MAX_OBS_CHARS {
                                format!("{}... [TRUNCATED {} chars]", &obs[..MAX_OBS_CHARS], obs.len() - MAX_OBS_CHARS)
                            } else {
                                obs
                            };
                            
                            session_obs.push(clean_obs.clone());
                            
                            if clean_obs.contains("_OK") || clean_obs.contains("FAILED") || clean_obs.contains("[CMD:") {
                                break;
                            }
                        }
                    }
                    Err(e) => session_obs.push(format!("EXECUTOR_FAULT: {}", e)),
                }

                if actions.iter().any(|a| matches!(a, AgentAction::Halt { .. })) {
                    info!(">> [MISSION COMPLETE] Agent halted.");
                    break;
                }
            }
            Err(e) => {
                consecutive_fractures += 1;
                warn!(
                    "Turn {} | Parser fracture ({}/{}): {}",
                    turn, consecutive_fractures, MAX_CONSECUTIVE_FRACTURES, e
                );

                // ⚡ FIX: Remove previous warnings, but PUSH the new one to the END 
                // so it enters the Turn N+1 sliding context window.
                session_obs.retain(|o| !o.starts_with("[FORMAT_VIOLATION]"));
                session_obs.push(FORMAT_CORRECTION.to_string());
            }
        }

        tokio::time::sleep(tokio::time::Duration::from_millis(500)).await;
    }

    "TASK_COMPLETE".to_string()
}
