// ──────────────────────────────────────────────────────────────
// Podman container management module (aka "Drone" system)
// Optimized for 4 GB RAM devices — very low limits + safety checks

use anyhow::{anyhow, Result};
use serde::Serialize;
use std::env;
use std::fs;
use std::process::Command;
use sysinfo::System;

#[derive(Serialize, Debug, Clone)]
pub struct Container {
    pub id: String,
    pub image: String,
    pub status: String,
    pub names: String,
}

pub struct PodmanEngine;

impl PodmanEngine {
    // Very conservative defaults for 4 GB reality
    fn get_resource_limits() -> (String, String) {
        let mem = env::var("NEXUS_DRONE_MEM").unwrap_or_else(|_| "48m".to_string());
        let cpu = env::var("NEXUS_DRONE_CPU").unwrap_or_else(|_| "0.15".to_string());
        (mem, cpu)
    }

    // Quick check if we have enough free RAM before starting anything heavy
    fn has_enough_ram(min_free_mb: u64) -> bool {
        let mut sys = System::new_all();
        sys.refresh_memory();
        let free_mb = sys.available_memory() / 1_024 / 1_024;
        println!(">> [PODMAN] Free RAM check: {} MB available (need >= {} MB)", free_mb, min_free_mb);
        free_mb >= min_free_mb
    }

    pub fn ensure_synapse() -> Result<()> {
        let check = Command::new("podman")
            .args(["ps", "-q", "-f", "name=nexus_synapse"])
            .output()?;

        if check.stdout.is_empty() {
            if !Self::has_enough_ram(280) {
                return Err(anyhow!("Not enough free RAM to start redis synapse (~280 MB needed)"));
            }

            let output = Command::new("podman")
                .args([
                    "run", "-d",
                    "--name", "nexus_synapse",
                    "--memory=48m",
                    "--cpus=0.15",
                    "-p", "6379:6379",
                    "--restart", "always",
                    "redis:alpine",
                ])
                .output()?;

            if !output.status.success() {
                return Err(anyhow!("Failed to start synapse: {}", String::from_utf8_lossy(&output.stderr)));
            }
        }
        Ok(())
    }

    pub fn list() -> Vec<Container> {
        let output = Command::new("podman")
            .args([
                "ps", "-a",
                "--format", "{{.ID}}|{{.Image}}|{{.Status}}|{{.Names}}",
            ])
            .output();

        if let Ok(out) = output {
            let raw = String::from_utf8_lossy(&out.stdout);
            raw.lines()
                .filter_map(|line| {
                    let parts: Vec<&str> = line.split('|').collect();
                    if parts.len() >= 4 {
                        Some(Container {
                            id: parts[0].to_string(),
                            image: parts[1].to_string(),
                            status: parts[2].to_string(),
                            names: parts[3].to_string(),
                        })
                    } else {
                        None
                    }
                })
                .collect()
        } else {
            Vec::new()
        }
    }

    pub fn spawn_drone(drone_type: &str) -> Result<String> {
        if !Self::has_enough_ram(380) {
            return Err(anyhow!("Low memory — refusing to spawn drone (need ~380 MB free)"));
        }

        let (mem_limit, cpu_limit) = Self::get_resource_limits();
        let _custom_name = format!("nexus_{}", drone_type.replace(" ", "_"));

        let (image, name, ports, command) = match drone_type {
            "secops" => (
                "alpine:latest",
                "nexus_secops",
                None,
                Some(vec![
                    "sh", "-c",
                    "apk add --no-cache nmap curl bind-tools && sleep infinity",
                ]),
            ),
            "devops" => ("node:18-alpine", "nexus_devops", None, Some(vec!["sleep", "infinity"])),
            "industrial" => (
                "postgres:alpine",
                "nexus_industrial",
                Some("5432"),
                Some(vec!["sleep", "infinity"]),
            ),
            _ => return Err(anyhow!("Unknown drone type: {}", drone_type)),
        };

        // Clean up old container with same name
        let _ = Command::new("podman").args(["rm", "-f", &name]).output();

        let mut cmd = Command::new("podman");
        cmd.arg("run")
            .arg("-d")
            .arg("--name").arg(&name)
            .arg("--init")
            .arg(format!("--memory={}", mem_limit))
            .arg(format!("--cpus={}", cpu_limit))
            .arg("--network").arg("slirp4netns:allow_host_loopback=true");

        if drone_type == "secops" {
            // SECURITY: read-only mount only
            if let Ok(cwd) = std::env::current_dir() {
                cmd.arg("-v").arg(format!("{}:/workspace:ro", cwd.display()));
            }
            cmd.arg(image);
            if let Some(args) = command {
                cmd.args(args);
            }
        } else {
            cmd.arg(image).args(command.unwrap_or(vec!["sleep", "infinity"]));
        }

        if let Some(port) = ports {
            cmd.arg("-p").arg(format!("{}:{}", port, port));
        }

        let res = cmd.output()?;
        if !res.status.success() {
            return Err(anyhow!("Podman spawn failed: {}", String::from_utf8_lossy(&res.stderr)));
        }

        let container_id = String::from_utf8_lossy(&res.stdout).trim().to_string();
        println!(">> [PODMAN] Spawned {} ({} MB, {} CPU)", name, mem_limit, cpu_limit);
        Ok(container_id)
    }

    pub fn forge_drone(name: &str, dockerfile: &str) -> Result<String> {
        let build_dir = format!("hives/{}", name);
        fs::create_dir_all(&build_dir)?;
        fs::write(format!("{}/Dockerfile", build_dir), dockerfile)?;

        let _ = Command::new("podman").args(["image", "prune", "-f"]).output();

        let output = Command::new("podman")
            .args(["build", "-t", name, &build_dir])
            .output()?;

        if output.status.success() {
            Ok(format!("Forged image: {}", name))
        } else {
            Err(anyhow!("Forge failed: {}", String::from_utf8_lossy(&output.stderr)))
        }
    }

    pub fn kill_all() -> Result<()> {
        for c in Self::list() {
            if c.names != "nexus_synapse" {
                let _ = Command::new("podman").args(["stop", &c.id]).output();
            }
        }
        Ok(())
    }

    pub fn deploy(image: &str, port: &str) -> Result<String> {
        let res = Command::new("podman")
            .args([
                "run",
                "-d",
                "--memory=96m",           // lowered from 256m
                "-p",
                &format!("{}:{}", port, port),
                image,
            ])
            .output()?;
        Ok(String::from_utf8_lossy(&res.stdout).trim().to_string())
    }

    pub fn nuke(id: &str) -> Result<()> {
        let _ = Command::new("podman").args(["rm", "-f", id]).output();
        Ok(())
    }
}

