pub struct NeuralParser;

impl NeuralParser {
    pub fn extract_actions(raw_llm_output: &str) -> Result<Vec<AgentAction>> {
        let mut cleaned = raw_llm_output.trim();
        if cleaned.starts_with("```json") { cleaned = &cleaned[7..]; } 
        else if cleaned.starts_with("```") { cleaned = &cleaned[3..]; }
        if cleaned.ends_with("```") { cleaned = &cleaned[..cleaned.len() - 3]; }
        cleaned = cleaned.trim();

        let json_payload = if let (Some(start), Some(end)) = (cleaned.find('['), cleaned.rfind(']')) {
            &cleaned[start..=end]
        } else if let (Some(start), Some(end)) = (cleaned.find('{'), cleaned.rfind('}')) {
            &cleaned[start..=end]
        } else {
            return Err(anyhow!("No JSON structure found."));
        };

        let parsed_value: Value = serde_json::from_str(json_payload)?;
        if parsed_value.is_array() {
            Ok(serde_json::from_value(parsed_value)?)
        } else {
            Ok(vec![serde_json::from_value(parsed_value)?])
        }
    }
}

