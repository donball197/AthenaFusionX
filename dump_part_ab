use anyhow::Result;
use chrono::Utc;
use serde::{Deserialize, Serialize};
use std::fs;
use std::path::Path;
use blake3::Hasher;

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct VaultEntry {
    pub timestamp: String,
    pub path: String,
    pub hash: String,
    pub author: String,
}

pub struct LazarusVault;

impl LazarusVault {
    pub fn init() -> Result<()> {
        fs::create_dir_all(".lazarus/snapshots")?;
        if !Path::new(".lazarus/ledger.json").exists() {
            fs::write(".lazarus/ledger.json", "[]")?;
        }
        Ok(())
    }

    // This is what server.rs calls to secure a file before/during a write
    pub fn seal_patch(target_path: &str, content: &str, author: &str) -> Result<String> {
        let mut hasher = Hasher::new();
        hasher.update(content.as_bytes());
        let hash = hasher.finalize().to_hex().to_string();

        let snapshot_path = format!(".lazarus/snapshots/{}.bak", hash);
        fs::write(snapshot_path, content)?;

        let mut ledger = Self::list_snapshots().unwrap_or_default();
        ledger.push(VaultEntry {
            timestamp: Utc::now().to_rfc3339(),
            path: target_path.to_string(),
            hash: hash.clone(),
            author: author.to_string(),
        });

        // Keep ledger lean for Duet RAM/Storage
        if ledger.len() > 100 { ledger.remove(0); }

        fs::write(".lazarus/ledger.json", serde_json::to_string_pretty(&ledger)?)?;
        Ok(hash)
    }

    pub fn list_snapshots() -> Result<Vec<VaultEntry>> {
        let content = fs::read_to_string(".lazarus/ledger.json")?;
        Ok(serde_json::from_str(&content)?)
    }

    pub fn restore_from_vault(hash: &str) -> Result<String> {
        let ledger = Self::list_snapshots()?;
        let entry = ledger.iter().find(|e| e.hash.starts_with(hash))
            .ok_or_else(|| anyhow::anyhow!("Hash not found in Lazarus Vault."))?;

        let snapshot_path = format!(".lazarus/snapshots/{}.bak", entry.hash);
        let content = fs::read_to_string(snapshot_path)?;
        fs::write(&entry.path, content)?;
        
        Ok(entry.path.clone())
    }
}

