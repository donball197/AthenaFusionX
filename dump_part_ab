#[derive(Serialize, Deserialize, Debug, Clone)]
pub struct AtlasEntry { pub name: String, pub kind: String, pub path: String, pub signature: String }

#[derive(Serialize, Deserialize, Debug, Clone, Default)]
pub struct ProjectAtlas { pub entries: Vec<AtlasEntry>, pub timestamp: String }

pub struct KnowledgeBroker;

impl KnowledgeBroker {
    pub async fn refresh_atlas() -> Result<String> {
        let mut entries = Vec::new();
        let rust_fn = Regex::new(r"pub\s+(?:async\s+)?fn\s+([a-zA-Z0-9_]+)[^{;]+")?;
        for entry in WalkDir::new("src") {
            let entry = entry?;
            let path = entry.path();
            if path.extension().map_or(false, |e| e == "rs") {
                let content = fs::read_to_string(path)?;
                for cap in rust_fn.captures_iter(&content) {
                    entries.push(AtlasEntry { name: cap[1].to_string(), kind: "fn".into(), path: path.to_string_lossy().into(), signature: cap[0].trim().into() });
                }
            }
        }
        let atlas = ProjectAtlas { entries, timestamp: chrono::Utc::now().to_rfc3339() };
        fs::write(".lazarus/atlas.json", serde_json::to_string_pretty(&atlas)?)?;
        Ok("Atlas Index Updated".into())
    }

    pub fn load_atlas() -> ProjectAtlas {
        let content = fs::read_to_string(".lazarus/atlas.json").unwrap_or_default();
        serde_json::from_str(&content).unwrap_or_default()
    }

    pub async fn get_graph(state: Arc<AppState>) -> crate::broker::NeuralGraph {
        // FIXED: Inline loading removes the need for explicit type annotation on the MutexGuard
        let memories: Vec<Memory> = state.memory.lock().await.load_all();
        
        let mut nodes = Vec::new();
        let mut links = Vec::new();
        
        for mem in memories.iter().filter(|m| m.prompt.starts_with("FOUNDATION:")) {
            let path = mem.prompt.replace("FOUNDATION: ", "");
            let group = if path.ends_with(".rs") { "rust" } else { "svelte" };
            let size = fs::metadata(&path).map(|m| m.len()).unwrap_or(500);
            nodes.push(GraphNode { id: path.clone(), group: group.to_string(), summary: mem.solution_code.clone(), size });
            if path != "src/main.rs" && group == "rust" { links.push(GraphLink { source: "src/main.rs".into(), target: path.clone() }); }
        }
        crate::broker::NeuralGraph { nodes, links }
    }
}

