use std::fs;

pub fn unified_diff(original_path: &str, against_path: &str) -> String {
    let original = match fs::read_to_string(original_path) {
        Ok(c) => c,
        Err(e) => return format!(">> Cannot read original {}: {}", original_path, e),
    };

    let against = match fs::read_to_string(against_path) {
        Ok(c) => c,
        Err(e) => return format!(">> Cannot read draft {}: {}", against_path, e),
    };

    let orig_lines: Vec<&str> = original.lines().collect();
    let new_lines: Vec<&str> = against.lines().collect();

    let mut result = Vec::new();
    let mut i = 0;
    let mut j = 0;

    result.push(format!("--- {}", original_path));
    result.push(format!("+++ {}", against_path));
    result.push("@@ -1,+1 @@".to_string());

    while i < orig_lines.len() || j < new_lines.len() {
        if i < orig_lines.len() && j < new_lines.len() && orig_lines[i] == new_lines[j] {
            result.push(format!(" {}", orig_lines[i]));
            i += 1;
            j += 1;
        } else {
            while i < orig_lines.len() && (j >= new_lines.len() || orig_lines[i] != new_lines[j]) {
                result.push(format!("-\x1b[31m{}\x1b[0m", orig_lines[i]));
                i += 1;
            }
            while j < new_lines.len() && (i >= orig_lines.len() || orig_lines[i] != new_lines[j]) {
                result.push(format!("+\x1b[32m{}\x1b[0m", new_lines[j]));
                j += 1;
            }
        }
    }

    if result.len() <= 3 {
        ">> No differences detected.".to_string()
    } else {
        result.join("\n")
    }
}

