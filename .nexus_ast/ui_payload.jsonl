let audioCtx;
let lastClick = 0;

export function initAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

export function playResonance(ramUsage) {
    if (!audioCtx) return;
    
    const now = audioCtx.currentTime;
    const ramInt = parseInt(ramUsage.replace('MB', '')) || 0;
    
    // Calculate interval based on RAM usage (150MB = 1s, 1800MB = 0.05s)
    const interval = Math.max(0.05, 1.0 - (ramInt / 2000));

    if (now - lastClick > interval) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(ramInt > 1800 ? 880 : 440, now);
        
        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.1);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(now + 0.1);
        lastClick = now;
    }
}
// NEXUS Synthetic Audio Engine
const playTone = (freq, type, duration, volume) => {
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(volume, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
    } catch(e) {}
};

export default {
    click: () => playTone(800, 'sine', 0.1, 0.1),
    processing: () => playTone(440, 'square', 0.05, 0.05),
    success: () => {
        playTone(1000, 'sine', 0.2, 0.1);
        setTimeout(() => playTone(1200, 'sine', 0.3, 0.1), 100);
    },
    error: () => playTone(150, 'sawtooth', 0.5, 0.2)
};
// Standardized API client with Sovereign Auth Suture

async function request(url, options = {}) {
    // ⚡ SUTURE: Global Authorization Header
    options.headers = {
        ...options.headers,
        'Authorization': 'SOVEREIGN'
    };

    try {
        const res = await fetch(url, options);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
    } catch (e) {
        console.error(`[API_FAULT] ${url}:`, e);
        return null;
    }
}

export async function readFile(path) {
    const data = await request(`/api/fs/read?path=${encodeURIComponent(path)}`);
    return data || { content: `// Failed to read ${path}\n` };
}

export async function writeFile(path, content) {
    return await fetch('/api/fs/write', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'SOVEREIGN' },
        body: JSON.stringify({ path, content })
    }).then(res => res.ok);
}

export async function listFiles(path = ".") {
    return await request(`/api/fs/list?path=${encodeURIComponent(path)}`) || [];
}

export async function runTask(directive) {
    const data = await request('/api/task', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ directive })
    });
    return data || { status: "ERROR", output: "Failed to queue task." };
}

export async function getMemories() {
    return await request('/api/memories') || [];
}

export async function getSnapshots() {
    return await request('/api/lazarus/snapshots') || [];
}
/**
 * Project Nexus Singularity - Robust Agent Pipeline v1.5.0
 */

export function normalizeResponse(response) {
    if (typeof response !== 'string') return "";
    return response.trim();
}

export function extractJSON(str) {
    const cleaned = normalizeResponse(str);
    const actions = [];
    
    // Regex to find all content inside <ACTION> tags
    const actionRegex = /<ACTION>([\s\S]*?)<\/ACTION>/g;
    let match;

    while ((match = actionRegex.exec(cleaned)) !== null) {
        try {
            const rawJson = match[1].trim();
            const parsed = JSON.parse(rawJson);
            
            // If it's an array, flatten it; if object, push it
            if (Array.isArray(parsed)) {
                actions.push(...parsed);
            } else {
                actions.push(parsed);
            }
        } catch (e) {
            console.error(">> PIPELINE_FAULT: Malformed JSON in block", e);
        }
    }

    return actions.length > 0 ? actions : null;
}

export function isSafePath(path) {
    const forbidden = [".env", "target/", "node_modules/", "/etc/", "../", ".ssh"];
    const normalized = path.toLowerCase();
    return !forbidden.some(f => normalized.includes(f));
}
