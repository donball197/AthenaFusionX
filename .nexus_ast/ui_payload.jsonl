export let WS = null;

function esc(str) {
    if (!str) return "";
    return str.replace(/[&<>'"]/g, 
        tag => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;'
        }[tag] || tag)
    );
}

export function pushTermLine(msg, cls = 'text-cyan-300', isHtml = false) {
    terminalLogs.update(logs => {
        const entry = isHtml ? { html: msg, cls } : { message: esc(msg), cls };
        const newLogs = [...logs, entry];
        if (newLogs.length > 100) newLogs.shift();
        return newLogs;
    });
}

export function connectWS() {
    if (WS) return;
    WS = new WebSocket('ws://localhost:3000/ws/nexus');
    
    WS.onopen = () => {
        wsReady.set(true);
        pushTermLine('[NEXUS_WS] Neural uplink established.', 'text-green-400');
    };

    WS.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            switch (data.type) {
                case 'telemetry':
                    systemVitals.set(data.payload);
                    break;
                case 'terminal':
                    pushTermLine(data.payload, data.cls || 'text-cyan-300');
                    break;
                case 'ghost_start':
                    isGhostTyping.set(true);
                    ghostBuffer.set("");
                    break;
                case 'ghost_token':
                    ghostBuffer.update(b => b + data.payload);
                    break;
                case 'ghost_end':
                    isGhostTyping.set(false);
                    break;
                case 'patch':
                    pendingPatch.set(data.payload);
                    break;
                case 'file_refresh':
                    fileTreeTrigger.update(n => (n || 0) + 1);
                    break;
                default:
                    console.warn('Unknown WS message:', data);
            }
        } catch (e) {
            console.error('WS Parse Error:', e);
        }
    };

    WS.onclose = () => {
        wsReady.set(false);
        pushTermLine('!! [NEXUS_WS] Connection severed. Reconnecting...', 'text-red-500');
        WS = null;
        setTimeout(connectWS, 2000);
    };

    WS.sendPayload = (payload) => {
        if (WS && WS.readyState === WebSocket.OPEN) {
            WS.send(JSON.stringify(payload));
        } else {
            pushTermLine('!! [FAULT] WebSocket not ready.', 'text-red-500');
        }
    };
}
<script>
    import { onMount } from 'svelte';
    import { ide } from '$lib/store.svelte.js';
    import { EditorState } from '@codemirror/state';
    import { EditorView, basicSetup } from 'codemirror'; // FIX: Restored to unified package
    import { oneDark } from '@codemirror/theme-one-dark';
    import { rust } from '@codemirror/lang-rust';

    let editorContainer;
    let view;

    onMount(() => {
        view = new EditorView({
            state: EditorState.create({
                doc: "// NEXUS_OS READY\n// Select a file from the DNA_FS explorer",
                extensions: [
                    basicSetup, 
                    oneDark, 
                    rust(),
                    // UPGRADE: Push manual edits back to the Svelte 5 store
                    EditorView.updateListener.of((update) => {
                        if (update.docChanged && ide.activeTab) {
                            const tab = ide.openTabs.find(t => t.path === ide.activeTab);
                            if (tab && tab.content !== update.state.doc.toString()) {
                                tab.content = update.state.doc.toString();
                                tab.isDirty = true;
                            }
                        }
                    })
                ]
            }),
            parent: editorContainer
        });

        return () => view?.destroy();
    });

    // DNA_SYNC: Pull from store when active tab or external content changes
    $effect(() => {
        if (!view) return;
        const currentPath = ide.activeTab;
        const currentFile = ide.openTabs.find(t => t.path === currentPath);
        
        // The condition prevents an infinite loop with the updateListener above
        if (currentFile && currentFile.content !== view.state.doc.toString()) {
            view.dispatch({
                changes: {
                    from: 0,
                    to: view.state.doc.length,
                    insert: currentFile.content
                }
            });
        }
    });
</script>

