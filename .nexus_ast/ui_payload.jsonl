    async function handleKeydown(e) {
        if (e.key !== 'Enter' || !inputValue.trim()) return;

        const cmd = inputValue.trim();
        pushTermLine(`nexus_visor> ${cmd}`, 'text-white');
        inputValue = '';

        const lower = cmd.toLowerCase();

        if (lower === 'clear') {
            terminalLogs.set([]);
            pushTermLine('[NEXUS] Terminal cleared.', 'text-cyan-400');
        } else if (lower === 'status') {
            pushTermLine('>> SYSTEM ONLINE | RESONANCE NOMINAL | HIVE ACTIVE', 'text-green-400');
        } else if (lower.startsWith('open ')) {
            const path = cmd.substring(5).trim();
            const data = await readFile(path);
            if (data?.content) {
                ide.mountFile(path, data.content);
                pushTermLine(`>> [MOUNTED]: ${path}`, 'text-green-400');
            } else {
                pushTermLine(`!! [FAULT]: File not found on host.`, 'text-red-500');
            }
        } else {
            // SUTURE: Stringify the payload so the Rust backend can deserialize it
            import('./NexusWS.js').then(({ WS }) => {
                if (WS && WS.readyState === 1) { // 1 === OPEN
                    WS.send(JSON.stringify({ type: 'directive', payload: cmd }));
                } else {
                    pushTermLine('!! [FAULT] WebSocket disconnected.', 'text-red-500');
                }
            });
        }
    }

    $effect(() => {
        terminalLogs; 
        if (logContainer) {
            logContainer.scrollTop = logContainer.scrollHeight;
        }
    });

    $effect(() => {
        if (inputRef) inputRef.focus();
    });
</script>

