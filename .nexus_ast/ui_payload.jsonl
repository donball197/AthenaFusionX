<script>
    import { pendingPatch, ide, fileTreeTrigger } from '$lib/store.svelte.js';
    import { pushTermLine } from './NexusWS.js';
    import { writeFile } from '$lib/api.js';

    async function applyPatch() {
        const patch = $pendingPatch;
        if (!patch) return;

        const success = await writeFile(patch.path, patch.content);
        
        if (success) {
            ide.mountFile(patch.path, patch.content);
            pushTermLine(`[PATCH] Applied successfully → ${patch.path}`, 'text-green-400');
            fileTreeTrigger.update(n => (n || 0) + 1); 
        } else {
            pushTermLine(`[PATCH] Failed to write ${patch.path}`, 'text-red-400');
        }

        pendingPatch.set(null);
    }

    function rejectPatch() {
        pushTermLine(`[PATCH] Rejected by operator: ${$pendingPatch?.path}`, 'text-yellow-400');
        pendingPatch.set(null);
    }
</script>

{#if $pendingPatch}
