<script>
    import { onMount } from 'svelte';
    import { pushTermLine } from './NexusWS.js';
    import { terminalLogs, systemVitals } from '$lib/store.svelte.js';
    import { get } from 'svelte/store';

    let isOpen = $state(false);
    let search = $state('');
    let selectedIndex = $state(0);

    const commands = [
        { id: 'status', label: 'Show System Status', icon: '📊', action: () => {
            const vitals = get(systemVitals);
            pushTermLine(`>> STATUS | TEMP: ${vitals.temperature.toFixed(1)}C | CPU: ${(vitals.cpu_load * 100).toFixed(1)}% | RAM: ${vitals.ram_gb.toFixed(2)}GB`, 'text-green-400');
        } },
        { id: 'clear', label: 'Clear Terminal', icon: '🧹', action: () => { terminalLogs.set([]); pushTermLine('[NEXUS] Terminal cleared.', 'text-cyan-400'); } },
        { id: 'audit', label: 'Run Security Audit', icon: '🔍', action: () => pushTermLine('>> [AUDIT] Initiating sovereign scan...', 'text-cyan-400') },
        { id: 'lazarus', label: 'Activate Lazarus Vault', icon: '⌛', action: () => pushTermLine('>> [LAZARUS] Timeline restored.', 'text-purple-400') },
        { id: 'vision', label: 'Toggle Visual Cortex', icon: '👁️', action: () => {} },
        { id: 'purge', label: 'Purge Neural Memories', icon: '🗑️', action: () => pushTermLine('!! [WARNING] Memory purge initiated.', 'text-red-400') }
    ];

    let filtered = $derived(
        search 
            ? commands.filter(c => c.label.toLowerCase().includes(search.toLowerCase()))
            : commands
    );

    $effect(() => {
        search; 
        selectedIndex = 0;
    });

    function execute() {
        if (filtered.length === 0) return;
        filtered[selectedIndex].action();
        isOpen = false;
        search = '';
    }

    function focusNode(node) {
        node.focus();
    }

    onMount(() => {
        const handler = (e) => {
            if (e.ctrlKey && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                isOpen = !isOpen;
                if (isOpen) {
                    search = '';
                    selectedIndex = 0;
                }
            }
            if (!isOpen) return;
            
            if (e.key === 'Escape') isOpen = false;
            if (e.key === 'Enter') { e.preventDefault(); execute(); }
            if (e.key === 'ArrowDown') { e.preventDefault(); selectedIndex = Math.min(selectedIndex + 1, filtered.length - 1); }
            if (e.key === 'ArrowUp') { e.preventDefault(); selectedIndex = Math.max(selectedIndex - 1, 0); }
        };
        window.addEventListener('keydown', handler);
        return () => window.removeEventListener('keydown', handler);
    });
</script>

