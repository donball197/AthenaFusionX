                    {/if}
                    
                    <button
                        on:click={(e) => deleteFile(file.path, e)}
                        class="opacity-0 group-hover:opacity-100 text-red-800 hover:text-red-500 px-1 transition-opacity"
                        title="Delete">✕</button>
