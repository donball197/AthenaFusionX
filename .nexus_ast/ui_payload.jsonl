    import TacticalBlade from './components/TacticalBlade.svelte';
    import Voice from './components/Voice.svelte';

    let userPrompt = "";
    let neuralResponse = ">> SYSTEM_RES_NOMINAL";
    let cortexLogs = [];
    let terminalLogs = [];

    async function executeAction() {
        if (!userPrompt.trim() || $isGhostTyping) return;
        WS.send({ type: 'directive', payload: userPrompt });
        userPrompt = "";
    }

    async function handleApplyPatch() {
        if (!$pendingPatch) return;
        
        try {
            await fetch('/api/fs/write', { 
                method: 'POST', 
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ path: $pendingPatch.path, content: $pendingPatch.content })
            });
            pendingPatch.set(null);
            WS.sendRaw(`[NEXUS] Patch applied successfully to ${$pendingPatch.path}`);
        } catch (e) {
            WS.sendRaw(`!! [FAULT] Failed to apply patch: ${e.message}`);
        }
    }

    onMount(() => {
        WS.connect();
        onMessage(data => {
            if (data.type === 'ghost_token') {
                cortexLogs = [...cortexLogs, data.payload];
                // Keep memory clean
                if (cortexLogs.length > 50) cortexLogs.shift();
            }
        });
    });

</script>

<div class="h-screen w-screen bg-black text-neon-green font-mono grid grid-cols-12 grid-rows-12 gap-1 p-1 overflow-hidden">
    <VisualCortex active={$layout.visionActive} />
    <header class="col-span-12 row-span-1 bg-[#0a0a0a] border-b border-[#30363d] flex items-center px-4 justify-between">
        <span class="font-bold text-neon-green tracking-widest">NEXUS SINGULARITY v1.9.0</span>
        <input bind:value={userPrompt} on:keydown={(e) => e.key === 'Enter' && executeAction()} class="bg-black border border-green-900 w-1/2 px-2 py-1 text-xs outline-none" placeholder="INPUT DIRECTIVE..." />
        <Voice bind:userPrompt isListening={$isGhostTyping} />
    </header>
    <div class="col-span-3 row-span-2"><Vitals ram={$systemVitals.ram_usage} cpu={$systemVitals.cpu_usage} status={$systemVitals.status} resonance={$systemVitals.resonance} /></div>
    <div class="col-span-6 row-span-2 border border-blue-900/20"><GhostCortex logs={cortexLogs} response={neuralResponse} active={true} /></div>
    <div class="col-span-3 row-span-2"><Heartbeat resonance={$systemVitals.resonance} /></div>
    <div class="col-span-2 row-span-9 border border-white/5"><Explorer open={$layout.sidebarVisible} onFileSelect={(p) => activeTab.set(p)} /></div>
    <div class="col-span-7 row-span-6"><Editor path={$activeTab} /></div>
    <div class="col-span-3 row-span-6 border border-white/5"><ResponseModule response={neuralResponse} isThinking={$isGhostTyping} patchAvailable={$pendingPatch !== null} onApplyPatch={handleApplyPatch} /></div>
    <div class="col-span-10 row-span-3"><GhostTerminal logs={terminalLogs} isThinking={$isGhostTyping} /></div>
</div>
