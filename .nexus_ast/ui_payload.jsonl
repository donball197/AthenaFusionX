            <span class="font-bold tracking-widest">PATCH DETECTED</span>
            <span class="text-yellow-600 truncate max-w-[150px]">{$pendingPatch.path}</span>
        </div>
        
        <pre class="bg-black/80 p-3 text-[10px] text-gray-400 overflow-auto max-h-32 mb-4 border border-yellow-900 custom-scrollbar">
{$pendingPatch.content?.slice(0, 300) || ''}{($pendingPatch.content?.length || 0) > 300 ? '\n...' : ''}
        </pre>

        <div class="flex gap-3">
            <button onclick={applyPatch} 
                    class="flex-1 py-3 bg-green-600 hover:bg-green-500 text-black font-bold tracking-widest text-[10px] transition-all">
