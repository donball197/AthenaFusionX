use crate::kernel::error::KernelError;
use crate::kernel::ffi::KernelOps;
use std::sync::Arc;

/// Vmo: Virtual Memory Object owning a kernel handle.
pub struct Vmo {
    pub handle: u32,
    pub size: usize,
    ops: Arc<dyn KernelOps>,
}

impl Vmo {
    /// clone: Generates a child VMO using the provided hardware interface.
    pub fn clone(ops: Arc<dyn KernelOps>, parent: u32, size: usize) -> Result<Self, KernelError> {
        if parent == 0 { return Err(KernelError::InvalidHandle(0)); }
        
        let handle = ops.vmo_clone(parent, size);
        if handle == 0 {
            Err(KernelError::VmoCloneFailed { parent, size })
        } else {
            Ok(Self { handle, size, ops })
        }
    }
}

impl Drop for Vmo {
    fn drop(&mut self) {
        self.ops.handle_close(self.handle);
    }
}
use crate::kernel::error::KernelError;
use crate::kernel::ffi::{self, ZX_VM_PERM_READ, ZX_VM_PERM_WRITE, ZX_VM_MAP_RANGE};
use crate::kernel::vmo::Vmo;
use std::ptr;

/// VirtualMemoryAddressRegion: Orchestrates address space mapping.
pub struct Vmar;

impl Vmar {
    /// map: Maps a VMO into the specified VMAR handle using centralized permissions.
    pub fn map(vmar_handle: u32, vmo: &Vmo) -> Result<*mut u8, KernelError> {
        let options = ZX_VM_PERM_READ | ZX_VM_PERM_WRITE | ZX_VM_MAP_RANGE;
        
        let addr = unsafe {
            ffi::raw::nexus_vmar_map(vmar_handle, options, vmo.handle, vmo.size)
        };

        if addr == ptr::null_mut() {
            Err(KernelError::VmarMapFailed { 
                vmar_handle,
                size: vmo.size 
            })
        } else {
            Ok(addr)
        }
    }
}
