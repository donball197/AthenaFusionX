// --- SOVEREIGN MUSCLE BRIDGE ---
extern "C" {
    pub fn zx_vmo_create_native(size: usize) -> u32;
    pub fn zx_handle_close_native(handle: u32);
    pub fn zx_vmo_write_native(handle: u32, buffer: *const u8, size: usize) -> i32;
    pub fn zx_vmo_read_native(handle: u32, buffer: *mut u8, size: usize) -> i32;
    pub fn muscle_get_active_vmos() -> u32;
    pub fn muscle_get_next_handle() -> u32;
}

lazy_static! {
    pub static ref HANDLE_REGISTRY: Mutex<HashMap<u32, HandleType>> = Mutex::new(HashMap::new());
}

pub enum HandleType {
    Vmo(u32),
    Vmar(vmar::Vmar),
}

/// The Guard: Automated protection. When this struct is dropped, 
/// it ensures the memory is physically unmapped from ARM64.
pub struct VmoGuard {
    pub id: u32,
}

impl Drop for VmoGuard {
    fn drop(&mut self) {
        let mut reg = HANDLE_REGISTRY.lock().unwrap();
        if reg.contains_key(&self.id) {
            unsafe { zx_handle_close_native(self.id); }
            reg.remove(&self.id);
            println!("\x1b[33m[GUARD] Handle 0x{:x} safely reclaimed.\x1b[0m", self.id);
        }
    }
}

pub fn get_live_telemetry() -> (u32, u32) {
    unsafe { (muscle_get_active_vmos(), muscle_get_next_handle()) }
}

pub fn close_handle(id: u32) -> bool {
    let mut reg = HANDLE_REGISTRY.lock().unwrap();
    if reg.contains_key(&id) {
        unsafe { zx_handle_close_native(id); }
        reg.remove(&id);
        true
    } else {
        false
    }
}

pub fn reclaim_all() -> usize {
    let mut reg = HANDLE_REGISTRY.lock().unwrap();
    let count = reg.len();
    for (&id, _) in reg.iter() {
        unsafe { zx_handle_close_native(id); }
    }
    reg.clear();
    count
}

pub fn register_handle(id: u32, h: HandleType) {
    let mut reg = HANDLE_REGISTRY.lock().unwrap();
    reg.insert(id, h);
}
