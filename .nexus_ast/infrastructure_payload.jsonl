pub async fn start_server(state: Arc<AppState>) {
    let app = Router::new()
        .route("/api/vitals",              get(handle_vitals))
        .route("/api/fs/list",             get(handle_fs_list))
        .route("/api/fs/read",             get(handle_read_file))
        .route("/api/fs/write",            post(handle_write_file))
        .route("/api/fs/delete",           delete(handle_delete_file))
        .route("/ws/nexus",                get(ws_nexus_handler))
        .fallback(static_handler)
        .with_state(state)
        .layer(CorsLayer::permissive());

    let addr = "0.0.0.0:3000";
    let listener = tokio::net::TcpListener::bind(&addr).await.unwrap();
    println!("\n>> [NEXUS] CONTROL ONLINE → http://localhost:3000\n");
    axum::serve(listener, app.into_make_service()).await.unwrap();
}

async fn handle_vitals(State(s): State<Arc<AppState>>) -> Json<VitalsResponse> {
    let v = s.monitor.get_vitals();
    Json(VitalsResponse {
        status:      v.status,
        cpu_usage:   v.cpu_usage,
        ram_usage:   v.ram_usage,
        resonance:   v.resonance,
        temperature: v.temperature,
    })
}

// ── File System API (Secured) ──

async fn handle_fs_list(Query(p): Query<ListParams>) -> impl IntoResponse {
    let root = p.path.as_deref().unwrap_or("src");
    if root.contains("..") || Path::new(root).is_absolute() {
        return (StatusCode::BAD_REQUEST, Json(serde_json::json!([]))).into_response();
    }
    let mut entries: Vec<FsEntry> = Vec::new();
    if let Ok(rd) = std::fs::read_dir(root) {
        for e in rd.flatten() {
            let name = e.file_name().to_string_lossy().to_string();
            if name.starts_with('.') || name == "target" || name == "node_modules" || name == "dist" { continue; }
            let is_dir = e.path().is_dir();
            let path = e.path().to_string_lossy().to_string();
            entries.push(FsEntry { name, path, is_dir });
        }
    }
    entries.sort_by(|a, b| b.is_dir.cmp(&a.is_dir).then(a.name.cmp(&b.name)));
    (StatusCode::OK, Json(entries)).into_response()
}

async fn handle_read_file(Query(p): Query<FileParams>) -> impl IntoResponse {
    if p.path.contains("..") || Path::new(&p.path).is_absolute() {
        return (StatusCode::FORBIDDEN, "PATH_VIOLATION").into_response();
    }
    match std::fs::read_to_string(&p.path) {
        Ok(content) => (StatusCode::OK, Json(FileContent { path: p.path, content })).into_response(),
        Err(_)      => (StatusCode::NOT_FOUND, "FILE_NOT_FOUND").into_response(),
    }
}

async fn handle_write_file(Json(payload): Json<FileContent>) -> impl IntoResponse {
    if payload.path.contains("..") || Path::new(&payload.path).is_absolute() {
        return (StatusCode::FORBIDDEN, "PATH_VIOLATION").into_response();
    }
    let path = Path::new(&payload.path);
    if let Some(parent) = path.parent() {
        let _ = std::fs::create_dir_all(parent);
    }
    match std::fs::write(path, &payload.content) {
        Ok(_)  => StatusCode::OK.into_response(),
        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()).into_response(),
    }
}

async fn handle_delete_file(Query(p): Query<FileParams>) -> impl IntoResponse {
    if p.path.contains("..") || Path::new(&p.path).is_absolute() {
        return (StatusCode::FORBIDDEN, "PATH_VIOLATION").into_response();
    }
    match std::fs::remove_file(&p.path) {
        Ok(_)  => StatusCode::OK.into_response(),
        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()).into_response(),
    }
}

// ── WebSocket (Two-Way Communication) ──

async fn ws_nexus_handler(ws: WebSocketUpgrade, State(state): State<Arc<AppState>>) -> impl IntoResponse {
    ws.on_upgrade(move |socket| handle_ws_session(socket, state))
}

async fn handle_ws_session(socket: WebSocket, state: Arc<AppState>) {
    let (mut sink, mut stream) = socket.split();

    let _ = sink.send(Message::Text(r#"{"type":"terminal","payload":">> [NEXUS] WebSocket link established."}"#.into())).await;

    // Outbound Telemetry and Ghost Tokens
    let mut rx = state.tx.subscribe();
    let state_outbound = state.clone();
    
    let outbound_task = tokio::spawn(async move {
        loop {
            tokio::select! {
                Ok(msg) = rx.recv() => {
                    // Filter and format outgoing Ghost signals and Terminal logs
                    let formatted = if let Ok(val) = serde_json::from_str::<serde_json::Value>(&msg) {
                        if let Some(token) = val.get("data").and_then(|v| v.as_str()) {
                            if val.get("type").and_then(|v| v.as_str()) == Some("ghost-out") {
                                serde_json::json!({"type": "ghost_token", "payload": token}).to_string()
                            } else {
                                serde_json::json!({"type": "terminal", "payload": token}).to_string()
                            }
                        } else if val.get("type").and_then(|v| v.as_str()) == Some("ghost-thinking") {
                            let is_thinking = val.get("value").and_then(|v| v.as_bool()).unwrap_or(false);
                            if is_thinking { r#"{"type":"ghost_start"}"#.into() } else { r#"{"type":"ghost_end"}"#.into() }
                        } else { msg }
                    } else { msg };

                    if sink.send(Message::Text(formatted)).await.is_err() { break; }
                }
                _ = tokio::time::sleep(std::time::Duration::from_millis(800)) => {
                    let v = state_outbound.monitor.get_vitals();
                    let vitals_frame = serde_json::json!({
                        "type": "telemetry",
                        "payload": {
                            "status": v.status, "cpu_usage": v.cpu_usage, "ram_usage": v.ram_usage, "resonance": v.resonance, "temperature": v.temperature
                        }
                    }).to_string();
                    if sink.send(Message::Text(vitals_frame)).await.is_err() { break; }
                }
            }
        }
    });

    // Inbound Client Directives
    while let Some(Ok(msg)) = stream.next().await {
        if let Message::Text(text) = msg {
            if let Ok(val) = serde_json::from_str::<serde_json::Value>(&text) {
                match val.get("type").and_then(|t| t.as_str()).unwrap_or("") {
                    "terminal_input" | "directive" => {
                        let cmd = val.get("data").or_else(|| val.get("payload")).and_then(|v| v.as_str()).unwrap_or("").trim().to_string();
                        if !cmd.is_empty() {
                            let agent_clone = state.agent.clone();
                            let client_clone = state.client.clone();
                            let api_key_clone = state.api_key.clone();
                            tokio::spawn(async move {
                                crate::task_manager::send_task(agent_clone, &client_clone, &api_key_clone, &cmd).await;
                            });
                        }
                    }
                    _ => {} 
                }
            }
        }
    }
    outbound_task.abort();
}

async fn static_handler(uri: Uri) -> impl IntoResponse {
    let path = uri.path().trim_start_matches('/').to_string();
    let final_path = if path.is_empty() { "index.html".into() } else { path };
    match Assets::get(&final_path) {
        Some(content) => {
            let mime = mime_guess::from_path(&final_path).first_or_octet_stream();
            ([(header::CONTENT_TYPE, mime.as_ref())], content.data).into_response()
        }
        None => (StatusCode::NOT_FOUND, "404").into_response(),
    }
}

