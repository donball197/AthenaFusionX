use std::fs;
use std::path::{Path, PathBuf};
use crate::nexus_error::NexusError;
use crate::agent_protocol::AgentAction;
use crate::diff::DiffEngine;

pub struct Executor;

impl Executor {
    pub async fn execute(actions: Vec<AgentAction>) -> Result<Vec<String>, NexusError> {
        let mut results = Vec::new();
        for action in actions {
            match action {
                AgentAction::ReadFile { path } => {
                    Self::validate_path_access(&path)?;
                    let c = fs::read_to_string(&path)?;
                    results.push(format!("SUCCESS: FILE_CONTENT of {}:\n{}", path, c));
                }
                AgentAction::PatchFile { path, search, replace } => {
                    Self::validate_path_access(&path)?;
                    let original = fs::read_to_string(&path)?;
                    match DiffEngine::apply(&original, &search, &replace) {
                        Ok(new_content) => {
                            fs::write(&path, new_content)?;
                            results.push(format!("SUCCESS: Patched {}", path));
                        }
                        Err(_) => {
                            // SUTURE: Self-Correction Logic
                            // If patch fails, give the AI the REAL code so it can fix the search string
                            results.push(format!("FAILURE: DNA_MISMATCH in {}. The file actually contains:\n{}", path, original));
                        }
                    }
                }
                AgentAction::WriteFile { path, content } => {
                    Self::validate_path_access(&path)?;
                    Self::apply_fix(&path, &content)?;
                    results.push(format!("SUCCESS: Integrated {}", path));
                }
                AgentAction::Message { message } => {
                    results.push(format!("MSG: {}", message));
                }
                _ => {}
            }
        }
        Ok(results)
    }

    pub fn apply_fix(path: &str, code: &str) -> Result<(), NexusError> {
        if let Some(parent) = Path::new(path).parent() {
            let _ = fs::create_dir_all(parent);
        }
        let cleaned = code.replace(r"\n", "\n").replace(r#"\""#, "\"");
        let final_code = cleaned.trim_matches('"').trim();
        fs::write(path, final_code).map_err(|e| NexusError::Other(e.to_string()))
    }

    pub fn validate_path_access(target: &str) -> Result<PathBuf, NexusError> {
        if target.contains("..") || Path::new(target).is_absolute() {
            return Err(NexusError::Other("SECURITY_VIOLATION".into()));
        }
        Ok(PathBuf::from(target))
    }
}
use serde::{Serialize, Deserialize};
use std::fs;
use std::path::Path;
use std::collections::VecDeque;
use chrono::Utc;
use sha2::{Sha256, Digest};
use anyhow::{Result, Context};

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct Snapshot {
    pub timestamp: String,
    pub path: String,
    pub author: String,
    pub hash: String,
    pub backup_path: String,
}

pub struct LazarusVault;

impl LazarusVault {
    const MAX_HISTORY: usize = 50;

    pub fn list_snapshots() -> Result<VecDeque<Snapshot>> {
        let ledger_path = Path::new(".lazarus/ledger.json");
        if !ledger_path.exists() { return Ok(VecDeque::new()); }
        let data = fs::read_to_string(ledger_path).context("Vault Read Fault")?;
        serde_json::from_str(&data).context("DNA Corruption")
    }

    pub fn auto_snapshot(target: &str, reason: &str) -> Result<String> {
        let content = fs::read_to_string(target).context("File missing")?;
        Self::seal_patch(target, &content, reason)
    }

    pub fn seal_patch(target: &str, content: &str, reason: &str) -> Result<String> {
        let root = Path::new(".lazarus/snapshots");
        fs::create_dir_all(root)?;

        let mut hasher = Sha256::new();
        hasher.update(content);
        let hash = hasher.finalize().iter().map(|b| format!("{:02x}", b)).collect::<String>();

        let timestamp = Utc::now().to_rfc3339();
        let backup_path = root.join(format!("{}.snap", Utc::now().timestamp_micros()));
        fs::write(&backup_path, content)?;
        
        let mut ledger = Self::list_snapshots()?;
        if ledger.len() >= Self::MAX_HISTORY { ledger.pop_front(); }

        ledger.push_back(Snapshot {
            timestamp,
            path: target.to_string(),
            author: format!("AUTO: {}", reason),
            hash: hash.clone(),
            backup_path: backup_path.to_string_lossy().to_string(),
        });
        
        fs::write(".lazarus/ledger.json", serde_json::to_string_pretty(&ledger)?)?;
        Ok(hash)
    }
}
