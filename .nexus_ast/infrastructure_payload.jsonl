use crate::nexus_error::NexusError;
use crate::agent_protocol::AgentAction;
use crate::component_runner::{AgentHandle, Capabilities};
use crate::lazarus_vault::LazarusVault;
use crate::podman::PodmanShield;
use std::fs;

pub struct Executor;

impl Executor {
    pub async fn execute_handle(
        handle: &AgentHandle,
        actions: Vec<AgentAction>,
    ) -> Result<Vec<String>, NexusError> {
        let mut results = Vec::new();

        for action in actions {
            match action {
                AgentAction::ReadFile { path } => {
                    if !handle.capabilities.contains(Capabilities::READ_FS) {
                        results.push(format!("!! DENIED: ReadFile on {} (Lacks Capability)", path));
                        continue;
                    }
                    match fs::read_to_string(&path) {
                        Ok(content) => results.push(format!(">> [READ] {}:\n{}", path, content)),
                        Err(e)      => results.push(format!("!! [READ_FAULT] {}: {}", path, e)),
                    }
                }

                AgentAction::WriteFile { path, content } => {
                    if !handle.capabilities.contains(Capabilities::WRITE_FS) {
                        results.push("!! DENIED: WriteFile (Lacks Capability)".into());
                        continue;
                    }
                    if std::path::Path::new(&path).exists() {
                        let _ = LazarusVault::auto_snapshot(&path, "Pre-AI Overwrite");
                    }
                    if let Some(parent) = std::path::Path::new(&path).parent() {
                        let _ = fs::create_dir_all(parent);
                    }
                    match fs::write(&path, &content) {
                        Ok(_)  => results.push(format!(">> [WROTE] {} (Lazarus Snapshot Created)", path)),
                        Err(e) => results.push(format!("!! [WRITE_FAULT] {}: {}", path, e)),
                    }
                }

                AgentAction::PatchFile { path, search, replace } => {
                    if !handle.capabilities.contains(Capabilities::WRITE_FS) {
                        results.push("!! DENIED: PatchFile (Lacks Capability)".into());
                        continue;
                    }
                    match fs::read_to_string(&path) {
                        Ok(original) => {
                            let _ = LazarusVault::auto_snapshot(&path, "Pre-AI Patch");
                            match crate::diff::DiffEngine::apply(&original, &search, &replace) {
                                Ok(patched) => match fs::write(&path, &patched) {
                                    Ok(_)  => results.push(format!(">> [PATCHED] {}", path)),
                                    Err(e) => results.push(format!("!! [PATCH_WRITE_FAULT] {}: {}", path, e)),
                                },
                                Err(e) => results.push(format!("!! [PATCH_FAULT] {}", e)),
                            }
                        }
                        Err(e) => results.push(format!("!! [PATCH_READ_FAULT] {}: {}", path, e)),
                    }
                }

                AgentAction::ExecuteCommand { command } => {
                    if !handle.capabilities.contains(Capabilities::SYSTEM_EXEC) {
                        results.push("!! DENIED: ExecuteCommand (Lacks Capability)".into());
                        continue;
                    }

                    // UPGRADE: True lexical parsing via shell-words. 
                    // Safely handles quotes without invoking a shell.
                    let parts = match shell_words::split(&command) {
                        Ok(p) => p,
                        Err(e) => {
                            results.push(format!("!! [EXEC_FAULT] Invalid command syntax (unmatched quotes?): {}", e));
                            continue;
                        }
                    };

                    if parts.is_empty() {
                        results.push("!! [EXEC_FAULT] Empty command rejected.".into());
                        continue;
                    }

                    // Sovereign whitelist — upgraded with 'git'
                    const ALLOWED: &[&str] = &["cargo", "npm", "zig", "ls", "echo", "grep", "find", "cat", "git"];
                    if !ALLOWED.contains(&parts[0].as_str()) {
                        results.push(format!(
                            "!! SECURITY: Command '{}' not in Sovereign Whitelist.", parts[0]
                        ));
                        continue;
                    }

                    let workspace = std::env::current_dir()
                        .unwrap()
                        .to_string_lossy()
                        .to_string();

                    let has_podman = std::process::Command::new("podman")
                        .arg("-v")
                        .output()
                        .is_ok();

                    if has_podman {
                        // Podman shield handles the raw command string internally inside the container
                        match PodmanShield::execute_isolated(&command, &workspace).await {
                            Ok(val)  => results.push(format!(">> [SHIELDED_EXEC]: {}", val)),
                            Err(e)   => results.push(format!("!! [BIO-DOME_FAULT]: {}", e)),
                        }
                    } else {
                        results.push(
                            ">> [WARNING]: Podman offline. Executing locally on drone hardware.".into()
                        );
                        // Execute locally using the properly tokenized arguments
                        match tokio::process::Command::new(&parts[0])
                            .args(&parts[1..])
                            .current_dir(&workspace)
                            .output()
                            .await
                        {
                            Ok(output) => {
                                let out = String::from_utf8_lossy(&output.stdout);
                                let err = String::from_utf8_lossy(&output.stderr);
                                results.push(format!(
                                    ">> [DRONE_EXEC]:\n{}{}",
                                    out, err
                                ));
                            }
                            Err(e) => results.push(format!("!! [DRONE_FAULT]: {}", e)),
                        }
                    }
                }

                AgentAction::Message { message } => {
                    results.push(format!(">> [MESSAGE]: {}", message));
                }

                AgentAction::SystemAudit { target, status, analysis } => {
                    let a = analysis
                        .map_or("None".into(), |v| serde_json::to_string_pretty(&v).unwrap_or_default());
                    results.push(format!(">> [AUDIT - {}]: {}\n{}", target, status, a));
                }

                AgentAction::ComponentStatus { components } => {
                    results.push(format!(
                        ">> [COMPONENT STATUS]:\n{}",
                        serde_json::to_string_pretty(&components).unwrap_or_default()
                    ));
                }

                AgentAction::ReadinessReport { overall_status, version, deployment_target, next_step } => {
                    results.push(format!(
                        ">> [READINESS - v{}]: {} (Target: {})\n   Next: {}",
                        version, overall_status, deployment_target, next_step
                    ));
                }

                _ => results.push("!! [AGENT]: Action rejected by protocol.".into()),
            }
        }

        Ok(results)
    }
}
use serde::{Serialize, Deserialize};
use std::fs;
use std::path::Path;
use std::collections::VecDeque;
use chrono::Utc;
use sha2::{Sha256, Digest};
use anyhow::{Result, Context};

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct Snapshot {
    pub timestamp: String,
    pub path: String,
    pub author: String,
    pub hash: String,
    pub backup_path: String,
}

pub struct LazarusVault;

impl LazarusVault {
    const MAX_HISTORY: usize = 50;

    pub fn list_snapshots() -> Result<VecDeque<Snapshot>> {
        let ledger_path = Path::new(".lazarus/ledger.json");
        if !ledger_path.exists() { return Ok(VecDeque::new()); }
        let data = fs::read_to_string(ledger_path).context("Vault Read Fault")?;
        serde_json::from_str(&data).context("DNA Corruption")
    }

    pub fn auto_snapshot(target: &str, reason: &str) -> Result<String> {
        let content = fs::read_to_string(target).unwrap_or_default();
        Self::seal_patch(target, &content, reason)
    }

    pub fn seal_patch(target: &str, content: &str, reason: &str) -> Result<String> {
        let root = Path::new(".lazarus/snapshots");
        fs::create_dir_all(root)?;

        let mut hasher = Sha256::new();
        hasher.update(content);
        let hash = hasher.finalize().iter().map(|b| format!("{:02x}", b)).collect::<String>();

        let timestamp = Utc::now().to_rfc3339();
        let backup_path = root.join(format!("{}.snap", Utc::now().timestamp_micros()));
        fs::write(&backup_path, content)?;
        
        let mut ledger = Self::list_snapshots().unwrap_or_default();
        if ledger.len() >= Self::MAX_HISTORY { ledger.pop_front(); }

        ledger.push_back(Snapshot {
            timestamp,
            path: target.to_string(),
            author: format!("AUTO: {}", reason),
            hash: hash.clone(),
            backup_path: backup_path.to_string_lossy().to_string(),
        });
        
        fs::write(".lazarus/ledger.json", serde_json::to_string_pretty(&ledger)?)?;
        Ok(hash)
    }

    pub fn restore_snapshot(hash_prefix: &str) -> Result<String> {
        let ledger = Self::list_snapshots()?;
        let target_snap = ledger.iter().find(|s| s.hash.starts_with(hash_prefix))
            .context("!! [VAULT] Snapshot hash not found.")?;

        if !Path::new(&target_snap.backup_path).exists() {
            return Err(anyhow::anyhow!("!! [VAULT] Physical backup file missing."));
        }

        let safe_content = fs::read_to_string(&target_snap.backup_path)?;
        fs::write(&target_snap.path, safe_content)?;
        Ok(format!(">> [RESTORED] {} reverted to state {}", target_snap.path, hash_prefix))
    }
}
