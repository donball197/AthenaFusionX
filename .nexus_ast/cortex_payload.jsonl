use crate::nexus_error::NexusError;
use serde::{Serialize, Deserialize};
use serde_json::{json, Value};
use reqwest::Client;
use std::collections::VecDeque;
use std::sync::Mutex;
use tokio::sync::broadcast;
use futures_util::StreamExt;

#[derive(Debug, Serialize, Deserialize, Clone, Default)]
pub struct ContextPacket {
    pub current_file: String,
    pub recent_logs: Vec<String>,
    pub file_content: Option<String>,
    pub terminal_log: Option<String>,
    pub system_prompt: Option<String>,
    pub target_model: Option<String>,
}

pub struct MicroAgent {
    pub memory: Mutex<VecDeque<Value>>,
    pub tx: broadcast::Sender<String>,
}

impl MicroAgent {
    pub fn init(tx: broadcast::Sender<String>) -> Result<Self, NexusError> {
        Ok(MicroAgent { memory: Mutex::new(VecDeque::with_capacity(16)), tx })
    }

    pub async fn prepare_and_run(
        &self,
        client: &Client,
        api_key: &str,
        user_text: &str,
        ctx: ContextPacket,
        _resonance: f32,
    ) -> Result<(String, u128), NexusError> {
        let start = std::time::Instant::now();
        
        // SUTURE 1: Mapping to a valid model hosted on the Google REST API.
        let model = ctx.target_model.unwrap_or_else(|| "gemini-1.5-pro-latest".to_string());
        
        let system_instruction = format!(
            "SYSTEM_PROMPT: {}\nACTIVE_FILE: {}\nFILE_CONTENT:\n```\n{}\n```",
            ctx.system_prompt.unwrap_or_else(|| "You are NEXUS Ghost, a Sovereign AI Architect.".to_string()),
            ctx.current_file,
            ctx.file_content.unwrap_or_else(|| "None".to_string())
        );

        let url = format!(
            "https://generativelanguage.googleapis.com/v1beta/models/{}:streamGenerateContent?alt=sse&key={}", 
            model, 
            api_key
        );

        let payload = json!({ 
            "contents": [
                {
                    "role": "user",
                    "parts": [{ "text": format!("{}\n\nDIRECTIVE: {}", system_instruction, user_text) }]
                }
            ],
            "generationConfig": {
                "temperature": 0.15,
                "maxOutputTokens": 8192,
                "topP": 0.95
            }
        });
        
        let _ = self.tx.send(json!({"type": "ghost_start"}).to_string());

        let response = match client.post(&url).json(&payload).send().await {
            Ok(res) => res,
            Err(e) => {
                let _ = self.tx.send(json!({"type": "ghost_end"}).to_string());
                let err_msg = format!("!! [API_FAULT] Connection Failed: {}", e);
                let _ = self.tx.send(json!({"type": "directive", "payload": &err_msg}).to_string());
                return Err(NexusError::Other(err_msg));
            }
        };

        if !response.status().is_success() {
            let status = response.status();
            let err_text = response.text().await.unwrap_or_default();
            let _ = self.tx.send(json!({"type": "ghost_end"}).to_string());
            
            // SUTURE 2: Broadcast the HTTP error directly to the Visor terminal
            let formatted_err = format!("!! [API_HTTP_FAULT] Code {}: {}", status, err_text);
            let _ = self.tx.send(json!({"type": "directive", "payload": &formatted_err}).to_string());
            
            return Err(NexusError::Other(formatted_err));
        }

        let mut full_text = String::new();
        let mut buffer = String::new();
        let mut stream = response.bytes_stream();

        while let Some(item) = stream.next().await {
            match item {
                Ok(bytes_chunk) => {
                    buffer.push_str(&String::from_utf8_lossy(&bytes_chunk));
                    
                    while let Some(pos) = buffer.find("\n\n") {
                        let chunk = buffer[..pos].to_string();
                        buffer = buffer[pos+2..].to_string();
                        
                        let clean_chunk = chunk.trim_start_matches("data: ").trim();
                        if clean_chunk.is_empty() || clean_chunk == "[" || clean_chunk == "]" { 
                            continue; 
                        }
                        
                        match serde_json::from_str::<Value>(clean_chunk) {
                            Ok(val) => {
                                if let Some(candidates) = val.get("candidates").and_then(|c| c.as_array()) {
                                    if let Some(first_candidate) = candidates.first() {
                                        if let Some(parts) = first_candidate.get("content").and_then(|c| c.get("parts")).and_then(|p| p.as_array()) {
                                            if let Some(first_part) = parts.first() {
                                                if let Some(token) = first_part.get("text").and_then(|t| t.as_str()) {
                                                    full_text.push_str(token);
                                                    let _ = self.tx.send(json!({"type": "ghost_token", "payload": token}).to_string());
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            Err(e) => {
                                println!(">> [PARSE_WARN] Failed to parse SSE chunk: {}", e);
                            }
                        }
                    }
                },
                Err(e) => {
                    let err_msg = format!("!! [STREAM_FAULT] Stream interrupted: {}", e);
                    let _ = self.tx.send(json!({"type": "directive", "payload": &err_msg}).to_string());
                    break;
                }
            }
        }

        let _ = self.tx.send(json!({"type": "ghost_end"}).to_string());
        let duration = start.elapsed().as_millis();
        
        if full_text.is_empty() {
             let err_msg = "!! [EMPTY_RESPONSE] The Conductor returned zero tokens.".to_string();
             let _ = self.tx.send(json!({"type": "directive", "payload": &err_msg}).to_string());
             return Err(NexusError::Other(err_msg));
        }
        
        Ok((full_text, duration))
    }
}
use crate::neural_agent::{ContextPacket, MicroAgent};
use crate::json_parser::NeuralParser;
use crate::executor::Executor;
use crate::component_runner::{AgentComponent, Capabilities};
use crate::resonator::ResonatorCore;
use crate::memory::MemoryPalace;
use std::process::Command;
use std::collections::HashSet;
use std::sync::Arc;
use tokio::sync::Mutex;

pub async fn send_task(
    agent: Arc<MicroAgent>, 
    client: &reqwest::Client, 
    api_key: &str, 
    directive: &str,
    memory: Arc<Mutex<MemoryPalace>>
) -> String {
    let temp = ResonatorCore::read_thermal_temp();
    let turns = if temp > 78.0 { 1 } else if temp > 68.0 { 3 } else { 6 };
    
    let mut session_log = format!(">> [THERMAL: {:.1}C] Cortical Retrieval Active. Turns: {}\n", temp, turns);

    // UPGRADE: Lock is acquired, data is extracted, and lock is immediately dropped.
    // This prevents holding the lock across await boundaries in the loop.
    let mut persistent_context = String::from("RECENT MEMORIES:\n");
    {
        let mem_guard = memory.lock().await;
        if let Ok(memories) = mem_guard.fetch_all().await {
            for m in memories.iter().rev().take(5) {
                persistent_context.push_str(&format!("User: {}\nAgent: {}\n", m.directive, m.result));
            }
        }
    }

    let spatial_map = Command::new("find")
        .args([
            ".",
            "-maxdepth", "4",
            "-not", "-path", "./target*",
            "-not", "-path", "./ui/node_modules*",
            "(", "-name", "*.rs", "-o", "-name", "*.zig", "-o", "-name", "*.svelte", "-o", "-name", "*.js", "-o", "-name", ".env", ")"
        ])
        .output()
        .ok()
        .map(|o| String::from_utf8_lossy(&o.stdout).to_string())
        .unwrap_or_default();

    let mut observation_log = String::new();
    let mut history: HashSet<String> = HashSet::new();
    let handle = AgentComponent::spawn("Nexus_Architect", Capabilities::ALL, agent.clone(), agent.tx.clone());

    for turn in 1..=turns {
        let full_prompt = format!(
            "{}\n\
             DNA_MAP: {}\n\
             MISSION: {}\n\
             OBSERVATIONS: {}\n\n\
             STRICT PROTOCOL: You are a Sovereign Agent. You must respond with a JSON array of actions matching this exact schema. DO NOT invent new actions:\n\
             [\n\
               {{ \"action\": \"read_file\", \"path\": \"<string>\" }},\n\
               {{ \"action\": \"execute_command\", \"command\": \"<string>\" }},\n\
               {{ \"action\": \"message\", \"message\": \"<string>\" }},\n\
               {{ \"action\": \"readiness_report\", \"overall_status\": \"<string>\", \"version\": \"<string>\", \"deployment_target\": \"<string>\", \"next_step\": \"<string>\" }}\n\
             ]",
            persistent_context, spatial_map, directive, observation_log
        );

        match agent.prepare_and_run(client, api_key, &full_prompt, ContextPacket::default(), 0.1).await {
            Ok((response, _)) => {
                if let Ok(actions) = NeuralParser::extract_actions(&response) {
                    // UPGRADE: Deduplication based on parsed semantic actions, not raw string
                    let action_hash = serde_json::to_string(&actions).unwrap_or_default();
                    if history.contains(&action_hash) { break; }
                    history.insert(action_hash);

                    for action in &actions {
                        if let crate::agent_protocol::AgentAction::ReadFile { path } = action {
                            let _ = agent.tx.send(serde_json::json!({"type": "file_opened", "payload": path}).to_string());
                        }
                    }

                    if let Ok(results) = Executor::execute_handle(&handle, actions.clone()).await {
                        for res in results {
                            session_log.push_str(&format!("\n[Turn {}]: {}", turn, res));
                            observation_log.push_str(&format!("\n[Turn {}]: {}", turn, res));
                        }
                    }
                } else {
                    session_log.push_str("\n>> [EXECUTION FAULT]: JSON Schema Mismatch. Action Rejected.");
                }
            }
            Err(_e) => break,
        }
    }
    
    let mem_guard = memory.lock().await;
    let _ = mem_guard.store_memory("User", directive, &session_log).await;
    
    session_log
}
use crate::neural_agent::{MicroAgent, ContextPacket};
use crate::component_runner::AgentHandle;
use crate::agent_protocol::AgentAction;
use crate::arbiter_agent::ArbiterAgent;
use anyhow::Result;
use std::sync::Arc;

pub struct Orchestrator {
    pub agent: Arc<MicroAgent>,
    handle: AgentHandle,
}

impl Orchestrator {
    pub fn new(agent: Arc<MicroAgent>) -> Self {
        let (tx, _) = tokio::sync::broadcast::channel(16);
        let handle = crate::component_runner::AgentComponent::spawn(
            "orchestrator",
            crate::component_runner::Capabilities::READ_FS | crate::component_runner::Capabilities::WRITE_FS,
            agent.clone(),
            tx,
        );

        Self { agent, handle }
    }

    pub async fn run_autonomous_loop(
        &self,
        instruction: String,
        context: ContextPacket,
        client: &reqwest::Client,
        api_key: &str,
        _tx: &tokio::sync::broadcast::Sender<String>,
        _monitor: &crate::system_monitor::SystemMonitor,
    ) -> Result<String> {
        let (raw_response, _) = self.agent.prepare_and_run(client, api_key, &instruction, context, 1.0)
            .await
            .map_err(|e| anyhow::anyhow!(e.to_string()))?;

        match AgentAction::extract_and_parse(&raw_response) {
            Ok(actions) => {
                // UPGRADE: Consult the Arbiter before executing the loop
                let arbiter = ArbiterAgent::new(self.agent.clone(), None);
                let action_json = serde_json::to_string(&actions).unwrap_or_default();
                
                if let Ok(report) = arbiter.analyze_directive(api_key, &action_json).await {
                    if !report.can_proceed || report.risk_score >= 0.45 {
                        return Ok(format!("!! [ARBITER BLOCK] Risk Score: {:.2}. Reason: {}", report.risk_score, report.recommendation));
                    }
                }

                let results: Vec<String> = self.handle.execute_actions(actions).await
                    .map_err(|e| anyhow::anyhow!(e.to_string()))?;
                Ok(results.join("\n"))
            }
            Err(e) => {
                println!(">> [ORCHESTRATOR] Protocol extraction failed: {}. Returning raw response.", e);
                Ok(raw_response)
            }
        }
    }
}
