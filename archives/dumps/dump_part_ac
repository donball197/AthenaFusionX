        let mut current_input = initial_input;
        let mut final_raw_response;

        loop {
            let _ = tx.send(json!({"type": "SYSTEM_LOG", "token": format!(">> [SWARM] Cognitive Loop Turn {}\n", iterations + 1)}).to_string());
