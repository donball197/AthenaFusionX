pub async fn terminal_command(
    State(state): State<Arc<AppState>>,
    Json(payload): Json<serde_json::Value>,
) -> AxumJson<serde_json::Value> {
    let cmd_str = payload["command"].as_str().unwrap_or_default().trim();
    if cmd_str.is_empty() { return AxumJson(json!({ "output": ">> Empty command." })); }

    let args: Vec<&str> = std::iter::once("nexus").chain(cmd_str.split_whitespace()).collect();

    match Cli::try_parse_from(args) {
        Ok(cli) => match cli.command {
            Commands::Build { path } => AxumJson(json!({ "output": format!(">> BUILD_START: {}", path) })),
            Commands::Heal { file } => {
                let err_log: String = get_compile_error_for_file(&file).await;
                if err_log.contains("No compile errors detected") { return AxumJson(json!({ "output": ">> File is clean." })); }
                match AutoHealer::attempt_auto_repair(&state, &file, &err_log).await {
                    Ok((true, msg)) => AxumJson(json!({ "output": format!(">> Heal Success:\n{}", msg), "action": "HEAL_COMPLETE", "file": file })),
                    _ => AxumJson(json!({ "output": ">> Heal failed." }))
                }
            },
            Commands::Open { file } => AxumJson(json!({ "output": format!(">> Opening {}", file), "action": "OPEN_FILE", "file": file })),
            Commands::Status => {
                let res = f32::from_bits(state.current_resonance.load(Ordering::Relaxed));
                AxumJson(json!({ "output": format!(">> SWARM_STATUS: ACTIVE\nRESONANCE: {:.2}", res) }))
            },
            Commands::Diff { original, against } => AxumJson(json!({ "output": unified_diff(&original, &against) })),
