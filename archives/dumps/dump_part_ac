    let task = NexusTask {
        id: format!("SYS_{}", chrono::Utc::now().timestamp_subsec_nanos()),
        domain, priority, payload, attempt_count: 0, response_tx: Some(res_tx), context,
    };
    tx.send(task).await.map_err(|_| anyhow::anyhow!("Queue Closed"))?;
    res_rx.await.map_err(|_| anyhow::anyhow!("Task Dropped"))
}

