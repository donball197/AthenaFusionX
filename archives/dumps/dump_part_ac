use tokio::time::timeout;
use crate::system_monitor::SystemMonitor;

#[derive(Debug, Serialize, Deserialize)]
pub struct CommandResult {
    pub success: bool,
    pub exit_code: Option<i32>,
    pub stdout: String,
    pub stderr: String,
    pub command: String,
    pub timestamp: String,
}

#[derive(Debug, Clone)]
pub struct AllowedCommand {
    pub binary: &'static str,
    pub allowed_args: &'static [&'static str],
    pub max_duration_secs: u64,
}

const COMMAND_WHITELIST: &[AllowedCommand] = &[
    AllowedCommand {
        binary: "cargo",
        allowed_args: &["check", "clippy", "fmt", "audit", "--quiet", "--message-format=short"],
        max_duration_secs: 60,
    },
    AllowedCommand {
        binary: "ls",
        allowed_args: &["-la", "src", "ui/src", "."],
        max_duration_secs: 5,
    },
    AllowedCommand {
        binary: "git",
        allowed_args: &["status", "diff", "--oneline"],
        max_duration_secs: 10,
    },
];

pub async fn execute_allowed_command(monitor: &SystemMonitor, raw_cmd: &str) -> Result<CommandResult> {
    let parts: Vec<&str> = raw_cmd.trim().split_whitespace().collect();
    if parts.is_empty() { return Err(anyhow::anyhow!("Empty command")); }
    let binary = parts[0];
    let args = &parts[1..];

    let allowed = COMMAND_WHITELIST.iter().find(|c| c.binary == binary)
        .ok_or_else(|| anyhow::anyhow!("Command Not Permitted: {}", binary))?;

    for arg in args {
        if arg.contains(&[';', '&', '|', '`', '$', '(', ')', '<', '>'][..]) {
            return Err(anyhow::anyhow!("Injection Attempt Blocked: {}", arg));
        }
    }

    let v = monitor.get_vitals();
    if v.cpu_load > 90.0 { return Err(anyhow::anyhow!("CPU_CRITICAL")); }

    let cmd_future = async {
        let child = Command::new(binary)
            .args(args)
            .stdout(Stdio::piped())
            .stderr(Stdio::piped())
            .spawn()
            .context("Failed to spawn command")?;

        let output = child.wait_with_output().await?;
        Ok(CommandResult {
            success: output.status.success(),
            exit_code: output.status.code(),
            stdout: String::from_utf8_lossy(&output.stdout).to_string(),
            stderr: String::from_utf8_lossy(&output.stderr).to_string(),
            command: raw_cmd.to_string(),
            timestamp: chrono::Utc::now().to_rfc3339(),
        })
    };

    match timeout(Duration::from_secs(allowed.max_duration_secs), cmd_future).await {
        Ok(res) => res,
        Err(_) => Err(anyhow::anyhow!("Command Timed Out")),
    }
}

