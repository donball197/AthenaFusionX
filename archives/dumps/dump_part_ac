pub async fn adjust_resonance(state: &Arc<AppState>, delta: f32, reason: &str) {
    let mut res = f32::from_bits(state.current_resonance.load(Ordering::Relaxed));
    let _old = res;
    res = (res + delta).clamp(0.1, 1.0);
    state.current_resonance.store(res.to_bits(), Ordering::SeqCst);
    let payload = json!({ "type": "RESONANCE_UPDATE", "resonance": res, "reason": reason, "delta": delta });
