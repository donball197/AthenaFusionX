// ──────────────────────────────────────────────────────────────
// Hiram: Integrity verification and system health monitor
// Periodically checks for existence of critical directories
// (missions/, claims/) and adjusts integrity score
// Used to detect sabotage or missing components
// Integrity range: 0–100% (starts at 100, can decay or recover)

use chrono::Utc;
use std::path::Path;

pub struct Hiram {
    pub integrity: i32,               // Current integrity percentage (0–100)
    pub last_verified: Option<i64>,   // Unix timestamp of last check
    pub verification_interval: i64,   // Seconds between checks
}

impl Hiram {
    // Creates new Hiram instance with given verification interval (seconds)
    pub fn new(verification_interval: i64) -> Self {
        Self {
            integrity: 100,
            last_verified: None,
            verification_interval,
        }
    }

    // Performs integrity check if interval has elapsed
    // Checks existence of missions/ and claims/ directories
    // Decreases integrity if missing, slowly recovers if present
    pub fn verify(&mut self) {
        let now = Utc::now().timestamp();

        // Skip if last check was recent
        if let Some(last) = self.last_verified {
            if now - last < self.verification_interval {
                return;
            }
        }

        // Core integrity checks
        let missions_ok = Path::new("missions").exists();
        let claims_ok = Path::new("claims").exists();

        if !missions_ok || !claims_ok {
            self.integrity = (self.integrity - 10).max(0);
            println!(
                ">> [KERNEL] WARNING: System folders missing! Integrity: {}%",
                self.integrity
            );
        } else if self.integrity < 100 {
            self.integrity += 1;
        }

        println!(">> [KERNEL] Integrity Check: {}%", self.integrity);
        self.last_verified = Some(now);
    }
}

