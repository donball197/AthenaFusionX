pub struct SyntaxSentinel;

impl SyntaxSentinel {
    pub fn validate_safety(path: &str, content: &str) -> Result<(), String> {
        // 1. Block destructive shell commands in Rust code
        if content.contains("std::process::Command") && content.contains("rm -rf") {
            return Err("Hypothesis Blocked: Destructive Command Detected.".into());
        }

        // 2. Block infinite loop risks in build scripts
        if content.contains("loop {") && !content.contains("sleep") && !content.contains("break") {
            return Err("Hypothesis Blocked: Potential Infinite Loop without Yield.".into());
        }

        // 3. ARCHITECTURAL GUARD: Prevent "Nesting Sabotage"
        if path.ends_with("main.rs") && content.contains("mod nexus_core {") {
            return Err("Architectural Sabotage Detected: Module nesting 'nexus_core' is forbidden. Maintain flat hierarchy.".into());
        }

        // ── Critical file protection ──
        // Block dangerous overwrites of main.rs that remove core startup logic
        if path.ends_with("main.rs") {
            let has_server = content.contains("axum::serve") ||
                             content.contains("start_server") ||
                             content.contains("tokio::main async fn main()");
            let has_scheduler = content.contains("MasterSupervisor::ignite") ||
                                content.contains("scheduler_tx");
            let is_too_short = content.lines().count() < 40 || content.len() < 800;

            if !has_server || !has_scheduler || is_too_short {
                return Err("SAFETY_BLOCK: Attempt to overwrite main.rs without essential server/scheduler logic".into());
            }
        }

        // Block suspiciously short replacements in any Rust file
        if path.ends_with(".rs") && content.len() < 300 && content.contains("fn main()") {
            return Err("SAFETY_BLOCK: Suspicious short main function replacement attempt".into());
        }

        // Require reasonable number of imports/modules in critical files
        if path.ends_with("main.rs") || path.ends_with("server.rs") {
            let import_count = content.lines()
                .filter(|l| l.trim_start().starts_with("use ") || l.trim_start().starts_with("mod "))
                .count();
            if import_count < 8 {
                return Err("SAFETY_BLOCK: Code removes too many imports/modules from critical file".into());
            }
        }

        Ok(())
    }
}

