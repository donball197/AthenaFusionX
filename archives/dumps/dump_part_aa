use reqwest::Client;
use serde_json::{json, Value};
use std::fs;
use anyhow::{Context, Result};

#[tokio::main]
async fn main() -> Result<()> {
    dotenvy::dotenv().ok();
    let key = std::env::var("GEMINI_API_KEY")
        .context("CRITICAL: GEMINI_API_KEY missing in .env")?;

    let code  = fs::read_to_string("src/main.rs").unwrap_or_default();
    let crash = fs::read_to_string("crash_report.txt").unwrap_or_default();

    if crash.is_empty() {
        println!(">> [SENTRY] No crash_report.txt found. Standing down.");
        return Ok(());
    }

    let prompt = format!(
        "Fix fatal Rust error.\nCrash:\n{}\n\nCode:\n{}\n\nReturn full corrected file in a ```rust block.",
        crash, code
    );

    let url = format!(
        "https://generativelanguage.googleapis.com/v1beta/models/gemma-3-27b-it:generateContent?key={}",
        key
    );

    let payload = json!({
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": { "temperature": 0.1, "maxOutputTokens": 8192 }
    });

    println!(">> [SENTRY] Transmitting crash report to 27B Logic Lead...");
    let client = Client::new();
    let res  = client.post(&url).json(&payload).send().await.context("API request failed")?;
    let body = res.json::<Value>().await?;

    let text = body.pointer("/candidates/0/content/parts/0/text").and_then(|v| v.as_str()).unwrap_or("");

    let patch = if text.contains("```rust") {
        text.split("```rust").nth(1).unwrap_or("").split("```").next().unwrap_or("").trim().to_string()
    } else {
        text.replace("```", "").trim().to_string()
    };

    if !patch.is_empty() && patch.len() > 50 {
        fs::write("src/main.rs", &patch)?;
        println!(">> [SENTRY] SUCCESS: main.rs resurrected.");
        let _ = fs::remove_file("crash_report.txt");
    }
    Ok(())
}

