// Lightweight system monitoring — tuned for low-RAM ARM devices

use std::sync::{Arc, Mutex};
use sysinfo::System;

#[derive(Clone)]
pub struct VitalsSnapshot {
    pub status: String,         // "ONLINE" or "CRITICAL"
    pub cpu_load: f32,          // Average CPU usage (%)
    pub ram_used_gb: f32,
    pub ram_total_gb: f32,
    pub resonance: f32,         // from heartbeat
}

#[derive(Clone)]
pub struct SystemMonitor {
    sys: Arc<Mutex<System>>,
}

impl SystemMonitor {
    pub fn new(existing_sys: Arc<Mutex<System>>) -> Self {
        SystemMonitor { sys: existing_sys }
    }

    pub fn get_vitals(&self) -> VitalsSnapshot {
        let mut sys = self.sys.lock().unwrap();
        sys.refresh_cpu_usage();
        sys.refresh_memory();

        let cpus = sys.cpus();
        let count = cpus.len() as f32;
        let total_usage: f32 = cpus.iter().map(|c| c.cpu_usage()).sum();
        let cpu_load = if count > 0.0 { total_usage / count } else { 0.0 };

        let ram_used  = sys.used_memory()  as f32 / 1_073_741_824.0;
        let ram_total = sys.total_memory() as f32 / 1_073_741_824.0;

        let status = if ram_used > 2.6 || cpu_load > 3.2 {
            "CRITICAL"
        } else {
            "ONLINE"
        }.to_string();

        VitalsSnapshot {
            status,
            cpu_load,
            ram_used_gb: ram_used,
            ram_total_gb: ram_total,
            resonance: 0.98, // placeholder — replace with real value if available
        }
    }

    // NEW: Used by janitor, healer, supervisor etc. to decide whether to sleep longer
    pub fn should_throttle(&self) -> bool {
        let v = self.get_vitals();
        v.ram_used_gb > 2.6 || v.cpu_load > 3.2
    }

