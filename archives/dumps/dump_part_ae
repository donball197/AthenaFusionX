    import * as Pipeline from '$lib/agentPipeline.js';

    let tabs = [];
    let activeTabPath = null;
    let currentCode = "// SYSTEM_READY";
    let currentPath = "NO_FILE_LOADED";
    let editorRef = null;
    let neuralResponse = ">> HIVE ONLINE"; 
    let isThinking = false;
    let userPrompt = "";
    let pendingPatches = [];
    let healingLog = [];
    let ghostLogs = [];
    let vitals = { status: "OFFLINE", cpu_usage: 0, ram_usage: "0.0", resonance: 0.0 }; 

    let showTimeline = false;
    let showPalette = false;
    let searchQuery = '';
    let searchResults = [];

    $: cpuStress = vitals.cpu_usage > 85;
    $: jitterSpeed = cpuStress ? '0.08s' : '0s';

    // Reactive Sync: Ensures the editor updates when tabs or active path changes
    openTabs.subscribe(t => {
        tabs = t;
        syncEditor();
    });
    activeTab.subscribe(p => {
        activeTabPath = p;
        syncEditor();
    });

    function syncEditor() {
        const tab = tabs.find(t => t.path === activeTabPath);
        if (tab) {
            currentCode = tab.content;
            currentPath = tab.path;
        }
    }

    async function openFile(path) {
        if (!path) return;
        healingLog = [`>> OPENING: ${path}`, ...healingLog].slice(0, 10);
        
        try {
            const res = await fetch(`/api/fs/read?path=${encodeURIComponent(path)}`);
            if (!res.ok) throw new Error(`HTTP_${res.status}`);
            
            const data = await res.json();
            
            // 1. Update/Add to tabs store
            openTabs.update(ts => {
                const exists = ts.find(t => t.path === path);
                if (exists) return ts.map(t => t.path === path ? { ...t, content: data.content, isDirty: false } : t);
                return [...ts, { path, content: data.content, isDirty: false }];
            });

            // 2. Switch focus
            activeTab.set(path);
            if (SoundFx?.click) SoundFx.click();

        } catch (err) {
            healingLog = [`>> ERR: FAILED_TO_READ ${path}`, ...healingLog];
            console.error(err);
        }
        showPalette = false;
        showTimeline = false;
    }

    async function saveCurrentTab(author = "ARCHITECT") {
        const tab = tabs.find(t => t.path === activeTabPath);
        if (!tab) return;
        try {
            const res = await fetch('/api/fs/write', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ path: tab.path, content: tab.content, author })
            });
            if (res.ok) {
                openTabs.update(ts => ts.map(t => t.path === activeTabPath ? { ...t, isDirty: false } : t));
                healingLog = [`>> [${author}] SAVED: ${tab.path}`, ...healingLog].slice(0, 15);
                if (SoundFx?.success) SoundFx.success();
            }
        } catch (err) {
            healingLog = [`>> ERR: DISK_WRITE_FAIL`, ...healingLog];
        }
    }

    async function executeAction() {
        if (!userPrompt.trim() || isThinking) return;
        isThinking = true;
        neuralResponse = ">> ANALYZING_STREAMS...";
        const input = userPrompt;
        userPrompt = "";
        
        try {
            const res = await fetch('/api/prompt', { 
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ prompt: input, context: currentCode }) 
            });
            const data = await res.json();
            const normalized = Pipeline.normalizeResponse(data.response);
            
            let foundPatches = [];
            const jsonActions = Pipeline.extractJSON(normalized);
            
            if (jsonActions) {
                const actions = Pipeline.validateActions(jsonActions);
                const msg = actions.find(a => a.action === 'Message');
                if (msg) neuralResponse = msg.message;
                foundPatches = actions.filter(a => a.action === 'WriteFile' && Pipeline.isSafePatch(a));
            } else {
                foundPatches = Pipeline.extractCodeBlocks(normalized);
                neuralResponse = normalized.split("FILE:")[0] || ">> DNA_EXTRACTED";
            }
            
            pendingPatches = foundPatches;
            if (pendingPatches.length > 0) SoundFx?.processing?.();
        } catch (err) {
            neuralResponse = ">> [ERROR] LINK_RUPTURE";
        } finally { isThinking = false; }
    }

    async function handleApplyAll(event) {
        const patches = event.detail;
        pendingPatches = []; 
        for (const patch of patches) {
            if (activeTabPath !== patch.path) await openFile(patch.path);
            if (editorRef?.typeIntoEditor) {
                await editorRef.typeIntoEditor(patch.content);
                await saveCurrentTab("SWARM");
            }
        }
    }

    onMount(() => {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const socket = new WebSocket(`${protocol}//${window.location.host}/ws/ghost`);
        socket.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.type === "vitals") vitals = data;
            if (data.type === "SYSTEM_LOG") ghostLogs = [data.token.trim(), ...ghostLogs].slice(0, 50);
        };
        window.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'k') { e.preventDefault(); showPalette = !showPalette; }
            if (e.ctrlKey && e.key === 'h') { e.preventDefault(); showTimeline = !showTimeline; }
            if (e.ctrlKey && e.key === 's') { e.preventDefault(); saveCurrentTab("ARCHITECT"); }
            if (e.key === 'Escape') { showPalette = false; showTimeline = false; pendingPatches = []; }
        });
    });
</script>

