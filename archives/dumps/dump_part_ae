            const cmd = commandInput.trim();
            history = [...history, `<span class="text-blue-400">$ ${cmd}</span>`];
            commandInput = ""; // clear input
            
            // Scroll to bottom immediately
            scrollToBottom();

            try {
                const res = await fetch('/api/terminal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: cmd })
                });
                
                const data = await res.json();
                
                // Format stdout/stderr preserving newlines
                if (data.output) {
                    history = [...history, data.output.replace(/\n/g, '<br>')];
                }

                // If the backend tells us to open a file, dispatch to the parent UI
                if (data.action === "OPEN_FILE" && data.file) {
                    dispatch('open', data.file);
                }
            } catch (err) {
                history = [...history, `<span class="text-red-500">>> COMMS ERROR: ${err.message}</span>`];
            }

            scrollToBottom();
        }
    }

    function scrollToBottom() {
        setTimeout(() => {
            if (terminalContainer) terminalContainer.scrollTop = terminalContainer.scrollHeight;
        }, 50);
    }
