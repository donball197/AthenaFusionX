<script>
    import { onMount, onDestroy } from 'svelte';
    import { EditorView, basicSetup } from "codemirror";
    import { EditorState } from "@codemirror/state";
    import { rust } from "@codemirror/lang-rust";
    import { oneDark } from "@codemirror/theme-one-dark";
    import { vim } from '@replit/codemirror-vim';
    import { isGhostTyping } from '$lib/store.js';

    export let value = "";
    export let path = "src/main.rs";
    export let onChange = (val) => {};
    export let vimMode = false;

    let editorElement;
    let view;

    function mountEditor() {
        const extensions = [
            basicSetup,
            rust(),
            oneDark,
            EditorView.updateListener.of(update => {
                if (update.docChanged && !$isGhostTyping) {
                    onChange(update.state.doc.toString());
                }
            }),
            EditorView.theme({
                "&": { height: "100%" },
                ".cm-scroller": { overflow: "auto", paddingBottom: "120px" },
            })
        ];
        if (vimMode) extensions.push(vim({}));
        view = new EditorView({
            state: EditorState.create({ doc: value, extensions }),
            parent: editorElement
        });
    }

    export async function typeIntoEditor(newFullCode) {
        if (!view) return;
        isGhostTyping.set(true);
        let i = 0;
        const chunkSize = 15; 
        return new Promise((resolve) => {
            const interval = setInterval(() => {
                if (i >= newFullCode.length) {
                    clearInterval(interval);
                    isGhostTyping.set(false);
                    onChange(newFullCode);
                    resolve();
                    return;
                }
                const nextChunk = newFullCode.slice(0, i + chunkSize);
                view.dispatch({
                    changes: { from: 0, to: view.state.doc.length, insert: nextChunk }
                });
                i += chunkSize;
            }, 10);
        });
    }

    $: if (editorElement && (vimMode !== undefined)) {
        if (view) view.destroy();
        mountEditor();
    }

    $: if (view && value !== view.state.doc.toString() && !$isGhostTyping) {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: value } });
    }

    onDestroy(() => { if (view) view.destroy(); });
</script>

