#!/bin/bash
# NEXUS UNIFIED LAUNCHER v1.1.1 — ARM64 Hardened

if [[ "$1" == "ghost" ]]; then
    shift
    ./nexus_ghost_core.sh "$@"
    exit 0
fi

echo -e "\e[36m>> [NEXUS] ALPINE PROTOCOL ENGAGED\e[0m"
case "$1" in
    clean)
        echo ">> [CLEAN] Scrubbing artifacts..."
        rm -rf target/ *.so
        ;;
    build)
        echo ">> [BUILD] Fusing Rust + Zig Muscle..."
        zig build-lib src/kernel/muscle.zig -dynamic -lc
        mv libmuscle.so .
        export RUSTFLAGS="-L ."
        cargo build --target aarch64-unknown-linux-gnu
        ;;
    *)
        echo "Usage: ./nexus [build|clean|ghost]"
        ;;
esac
