  c```bash
#!/usr/bin/env bash
# =============================================================================
# AthenaFusionX — surgical Phase 2 + Phase 3 repair
#
# Current verified state:
#   - ReplaceFunctionBody normalization is already fixed.
#   - 14 nexus_ast_tool mutation tests pass.
#   - nexus_runtime_core compiles.
#   - Runtime call sites still use legacy .apply().
#   - PATCH_IDEMPOTENT_OK machinery is absent.
#
# This script:
#   1. Switches cortical_loop preflight to apply_for_path().
#   2. Switches executor PatchFunction to apply_for_path().
#   3. Adds PATCH_IDEMPOTENT_OK to PatchMarkerAcquired.
#   4. Adds a verifier regression test using the exact current test module.
#   5. Adds deterministic idempotence evidence to cortical_loop.
#   6. Widens the critic fact override for real mutations OR idempotence.
#
# Safe to re-run.
# Every edit is anchored and refuses on drift.
# =============================================================================

set -euo pipefail

ROOT="${HOME}/AthenaFusionx"
cd "$ROOT"

MUTATION="apps/nexus_ast_tool/src/mutation.rs"
VERIFIER="crates/runtime_core/src/outcome_verifier.rs"
CORTEX="crates/runtime_core/src/cortical_loop.rs"
EXECUTOR="crates/runtime_core/src/executor.rs"

log()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m    OK: %s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m    REFUSED: %s\033[0m\n' "$*" >&2; }

require_file() {
    [[ -f "$1" ]] || {
        fail "file not found: $1"
        exit 1
    }
}

# =============================================================================
# PREFLIGHT
# =============================================================================

log "Preflight"

require_file "$MUTATION"
require_file "$VERIFIER"
require_file "$CORTEX"
require_file "$EXECUTOR"

echo "Project:  $ROOT"
echo "Mutation: $MUTATION"
echo "Verifier: $VERIFIER"
echo "Cortex:   $CORTEX"
echo "Executor: $EXECUTOR"

# =============================================================================
# PHASE 1 — verify normalization remains healthy
# =============================================================================

log "PHASE 1: verify existing ReplaceFunctionBody normalization"

cargo test -p nexus_ast_tool \
    apply_and_apply_for_path_agree_on_flush_left_payload \
    -- --nocapture

cargo test -p nexus_ast_tool \
    apply_for_path_normalizes_pre_indented_payload \
    -- --nocapture

cargo test -p nexus_ast_tool \
    apply_for_path_handles_impl_method_indent \
    -- --nocapture

ok "ReplaceFunctionBody normalization regression tests pass"

# =============================================================================
# PHASE 2A — cortical_loop preflight
# =============================================================================

log "PHASE 2A: switch Cortex PATCH_FUNCTION preflight to apply_for_path"

python3 - "$CORTEX" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

needle = "nexus_ast_tool::mutation::ReplaceFunctionBody::apply_for_path("

if needle in s:
    print("SKIP: Cortex already uses ReplaceFunctionBody::apply_for_path")
    sys.exit(0)

old = '''                        if let Some(strategy) =
                            nexus_ast_tool::mutation::get_strategy("ReplaceFunctionBody")
                        {
                            match strategy.apply(&original, function_name, new_body) {
'''

new = '''                        if let Some(strategy) =
                            nexus_ast_tool::mutation::get_strategy("ReplaceFunctionBody")
                        {
                            match nexus_ast_tool::mutation::ReplaceFunctionBody::apply_for_path(
                                std::path::Path::new(path),
                                &original,
                                function_name,
                                new_body,
                            ) {
'''

if old not in s:
    print("REFUSED: exact Cortex PATCH_FUNCTION preflight anchor not found")
    sys.exit(2)

p.write_text(s.replace(old, new, 1))
print("OK: Cortex preflight now uses apply_for_path")
PY

# =============================================================================
# PHASE 2B — executor
# =============================================================================

log "PHASE 2B: switch Executor PatchFunction to apply_for_path"

python3 - "$EXECUTOR" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

needle = "nexus_ast_tool::mutation::ReplaceFunctionBody::apply_for_path("

if needle in s:
    print("SKIP: Executor already uses ReplaceFunctionBody::apply_for_path")
    sys.exit(0)

old = '''                let patched = strategy
                    .apply(&source, &function_name, &new_body)
                    .map_err(|e| anyhow!("PatchFunction failed for '{}': {}", function_name, e))?;
'''

new = '''                let patched =
                    nexus_ast_tool::mutation::ReplaceFunctionBody::apply_for_path(
                        &safe_path,
                        &source,
                        &function_name,
                        &new_body,
                    )
                    .map_err(|e| {
                        anyhow!(
                            "PatchFunction failed for '{}': {}",
                            function_name,
                            e
                        )
                    })?;
'''

if old not in s:
    print("REFUSED: exact Executor PatchFunction anchor not found")
    sys.exit(2)

p.write_text(s.replace(old, new, 1))
print("OK: Executor PatchFunction now uses apply_for_path")
PY

log "PHASE 2 gate: runtime compile"

cargo check -p nexus_runtime_core

echo
echo "Active normalized runtime paths:"
rg -n -C 5 \
    'ReplaceFunctionBody::apply_for_path' \
    "$CORTEX" "$EXECUTOR"

ok "Phase 2 complete"

# =============================================================================
# PHASE 3A — verifier accepts idempotent completion
# =============================================================================

log "PHASE 3A: add PATCH_IDEMPOTENT_OK to PatchMarkerAcquired"

python3 - "$VERIFIER" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

if 'local_evidence.contains("[PATCH_IDEMPOTENT_OK]")' in s:
    print("SKIP: verifier already accepts PATCH_IDEMPOTENT_OK")
    sys.exit(0)

old = '''                CompletionCondition::PatchMarkerAcquired => {
                    local_evidence.contains("[PATCH_FUNCTION_OK]")
                        || local_evidence.contains("[DIFF_PATCH_OK]")
                        || local_evidence.contains("[REPLACE_LINES_OK]")
                }
'''

new = '''                CompletionCondition::PatchMarkerAcquired => {
                    local_evidence.contains("[PATCH_FUNCTION_OK]")
                        || local_evidence.contains("[PATCH_IDEMPOTENT_OK]")
                        || local_evidence.contains("[DIFF_PATCH_OK]")
                        || local_evidence.contains("[REPLACE_LINES_OK]")
                }
'''

if old not in s:
    print("REFUSED: exact PatchMarkerAcquired verifier anchor not found")
    sys.exit(2)

p.write_text(s.replace(old, new, 1))
print("OK: verifier accepts PATCH_IDEMPOTENT_OK")
PY

# =============================================================================
# PHASE 3B — verifier regression test
#
# Use the exact existing generic_cmd test as an insertion anchor.
# No weak final-brace fallback.
# =============================================================================

log "PHASE 3B: add idempotent verifier regression test"

python3 - "$VERIFIER" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

name = "fn idempotent_patch_is_a_valid_patch_completion"

if name in s:
    print("SKIP: idempotent verifier regression test already present")
    sys.exit(0)

anchor = '''    #[test]
    fn generic_cmd_ok_remains_legacy_compatible() {
'''

if anchor not in s:
    print("REFUSED: exact verifier test anchor not found")
    print("Expected: generic_cmd_ok_remains_legacy_compatible")
    sys.exit(2)

test = '''    #[test]
    fn idempotent_patch_is_a_valid_patch_completion() {
        let condition = CompletionCondition::PatchMarkerAcquired;

        let result = OutcomeVerifier::verify(
            "test_node",
            "[PATCH_IDEMPOTENT_OK] Existing source already satisfies the requested patch.",
            1.0,
            &[condition],
        );

        assert_eq!(result, CompletionStatus::Approved);
    }

'''

p.write_text(s.replace(anchor, test + anchor, 1))
print("OK: idempotent verifier regression test inserted")
PY

# =============================================================================
# PHASE 3C — Cortex idempotence state
# =============================================================================

log "PHASE 3C: add Cortex idempotence state"

python3 - "$CORTEX" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

flag = "let mut patch_idempotent_satisfied = false;"

if flag in s:
    print("SKIP: idempotence flag already present")
else:
    old = "        let mut patch_mutation_verified = false;\n"
    new = (
        "        let mut patch_mutation_verified = false;\n"
        "        let mut patch_idempotent_satisfied = false;\n"
    )

    if old not in s:
        print("REFUSED: exact patch_mutation_verified declaration not found")
        sys.exit(2)

    p.write_text(s.replace(old, new, 1))
    print("OK: idempotence flag added")
PY

# =============================================================================
# PHASE 3D — true no-op evidence
# =============================================================================

log "PHASE 3D: make true no-op deterministic and verifiable"

python3 - "$CORTEX" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

if "patch_idempotent_satisfied = true;" in s:
    print("SKIP: no-op arm already emits idempotent evidence")
    sys.exit(0)

old = '''                                Ok(_) => {
                                    self.log(format!(
                                        "[PATCH_MUTATION_CHECK] {}:{} is a true no-op.",
                                        path, function_name
                                    ));
                                }
'''

new = '''                                Ok(_) => {
                                    self.log(format!(
                                        "[PATCH_MUTATION_CHECK] {}:{} is a true no-op; source already satisfies the requested body.",
                                        path, function_name
                                    ));
                                    session.local_evidence.push_str(&format!(
                                        "[PATCH_IDEMPOTENT_OK] {}:{}\\nFunction '{}' in {} already satisfied the requested body.\\n",
                                        path,
                                        function_name,
                                        function_name,
                                        path
                                    ));
                                    patch_idempotent_satisfied = true;
                                }
'''

if old not in s:
    print("REFUSED: exact Cortex true-no-op arm not found")
    sys.exit(2)

p.write_text(s.replace(old, new, 1))
print("OK: true no-op now emits PATCH_IDEMPOTENT_OK")
PY

# =============================================================================
# PHASE 3E — widen critic fact override
# =============================================================================

log "PHASE 3E: widen critic fact override for mutation OR idempotence"

python3 - "$CORTEX" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1])
s = p.read_text()

old_cond = '''                if critic.confidence_modifier <= -0.25
                    && patch_mutation_verified
                    && critic_claims_noop
                {
'''

new_cond = '''                if critic.confidence_modifier <= -0.25
                    && (patch_mutation_verified || patch_idempotent_satisfied)
                    && critic_claims_noop
                {
'''

if old_cond in s:
    s = s.replace(old_cond, new_cond, 1)
    print("OK: critic override condition widened")
elif "(patch_mutation_verified || patch_idempotent_satisfied)" in s:
    print("SKIP: critic override condition already widened")
else:
    print("REFUSED: exact critic override condition not found")
    sys.exit(2)

old_body = '''                    self.log(
                        "\\x1b[1;36m>> [CRITIC FACT OVERRIDE] Deterministic AST validation proves the patch is a real source mutation; ignoring the critic's no-op veto.\\x1b[0m"
                            .to_string(),
                    );
                    session.local_evidence.push_str(
                        "[CRITIC_FACT_OVERRIDE] PATCH_FUNCTION mutation verified by \\
                         ReplaceFunctionBody; critic no-op classification rejected.\\n",
                    );
'''

new_body = '''                    let kind = if patch_mutation_verified {
                        "PATCH_FUNCTION mutation verified by ReplaceFunctionBody"
                    } else {
                        "PATCH_FUNCTION body already present in source (idempotent)"
                    };

                    self.log(format!(
                        "\\x1b[1;36m>> [CRITIC FACT OVERRIDE] Deterministic AST validation proves the patch postcondition holds; ignoring the critic's no-op veto ({}).\\x1b[0m",
                        kind
                    ));

                    session.local_evidence.push_str(&format!(
                        "[CRITIC_FACT_OVERRIDE] {}; critic no-op classification rejected.\\n",
                        kind
                    ));
'''

if old_body in s:
    s = s.replace(old_body, new_body, 1)
    print("OK: critic override evidence updated")
elif "PATCH_FUNCTION body already present in source (idempotent)" in s:
    print("SKIP: critic override body already updated")
else:
    print("REFUSED: exact existing critic override body not found")
    sys.exit(2)

p.write_text(s)
PY

# =============================================================================
# FINAL SOURCE INSPECTION
# =============================================================================

log "Final source inspection"

echo
echo "=================================================="
echo "IDEMPOTENCE MARKERS"
echo "=================================================="

rg -n -C 4 \
    'PATCH_IDEMPOTENT_OK|patch_idempotent_satisfied|PATCH_FUNCTION body already present in source \(idempotent\)|CRITIC FACT OVERRIDE' \
    "$CORTEX" "$VERIFIER"

echo
echo "=================================================="
echo "NORMALIZED RUNTIME PATHS"
echo "=================================================="

rg -n -C 5 \
    'ReplaceFunctionBody::apply_for_path' \
    "$CORTEX" "$EXECUTOR"

echo
echo "=================================================="
echo "VERIFIER REGRESSION TEST"
echo "=================================================="

rg -n -C 6 \
    'idempotent_patch_is_a_valid_patch_completion' \
    "$VERIFIER"

# =============================================================================
# FINAL GATES
# =============================================================================

log "FINAL GATE: cargo check"

cargo check -p nexus_ast_tool -p nexus_runtime_core

log "FINAL GATE: nexus_ast_tool mutation tests"

cargo test -p nexus_ast_tool mutation -- --nocapture

log "FINAL GATE: outcome_verifier tests"

cargo test -p nexus_runtime_core outcome_verifier -- --nocapture

log "REPAIR COMPLETE"

cat <<'EOF'

==================================================
REPAIR COMPLETE
==================================================

Verified:
  - ReplaceFunctionBody normalization
  - top-level function indentation
  - impl-method indentation
  - Cortex uses apply_for_path
  - Executor uses apply_for_path
  - PATCH_IDEMPOTENT_OK accepted by verifier
  - idempotent verifier regression test
  - Cortex idempotence evidence
  - critic override covers mutation OR idempotence
  - cargo check
  - mutation tests
  - outcome verifier tests

NEXT — LIVE VALIDATION

1. Run:
     ./nexus.sh

2. Submit the three-node AST mission.

3. First run should establish the real mutation and finish:
     NODE 1 -> READ_FUNCTION_OK
     NODE 2 -> PATCH_FUNCTION_OK
     NODE 3 -> cargo check succeeds
     DAG -> 3/3

4. Inspect:
     sed -n '1,10l' apps/math_utils/src/lib.rs

   `a + b` must have exactly one function-body indentation level.

5. Run the SAME mission a second time.

   The important evidence is:
     [PATCH_MUTATION_CHECK] ... true no-op; source already satisfies the requested body.
     [PATCH_IDEMPOTENT_OK] apps/math_utils/src/lib.rs:add
     [CRITIC FACT OVERRIDE] ... (PATCH_FUNCTION body already present in source (idempotent))

6. Run the SAME mission a third time.

   It should converge identically rather than accumulating turns or
   triggering the no-op loop.

EOF
