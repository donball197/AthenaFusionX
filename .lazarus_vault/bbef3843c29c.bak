use std::sync::{Arc, LazyLock};
use tokio::sync::{broadcast, Semaphore, Mutex};
use crate::agent_protocol::AgentAction;
use crate::{executor, json_parser};
use serde_json::json;

static TASK_SLAB: LazyLock<Arc<Semaphore>> =
    LazyLock::new(|| Arc::new(Semaphore::new(2)));

pub async fn send_task(
    agent: Arc<crate::neural_agent::MicroAgent>,
    client: &reqwest::Client,
    api_key: &str,
    directive: &str,
    memory: Arc<Mutex<crate::memory::MemoryPalace>>,
    tx: broadcast::Sender<String>,
) -> String {
    let directive = directive.trim();
    if directive.is_empty() { return "NO_DIRECTIVE".into(); }

    let _permit = TASK_SLAB.clone().acquire_owned().await.expect("SLAB_LOCK_FAIL");
    let mut session_obs = String::from("SENSORS_INIT: Substrate Ready.\n");

    // ⚡ v3.0: Infinite Loop Unshackled
    for turn in 1.. {
        // --- 🛡️ AUTONOMIC MEMORY GOVERNOR ---
        if let Ok(res) = client.get("http://localhost:3000/api/vitals").send().await {
            if let Ok(vitals) = res.json::<serde_json::Value>().await {
                let used_ram = vitals["ram_gb"].as_f64().unwrap_or(0.0);
                let total_ram = vitals["total_ram_gb"].as_f64().unwrap_or(2.7);
                let free_ram_mb = (total_ram - used_ram) * 1024.0;

                // Redline: Less than 512MB of Free RAM
                if free_ram_mb < 512.0 {
                    let warn_msg = format!(
                        "\n\x1b[33m>> [AUTONOMIC THROTTLE] MEMORY REDLINE DETECTED! Free RAM: {:.0}MB. Purging and Sleeping...\x1b[0m\n",
                        free_ram_mb
                    );
                    let _ = tx.send(json!({"type": "NEURAL_STREAM", "payload": warn_msg}).to_string());
                    println!("{}", warn_msg);
                    
                    tokio::time::sleep(tokio::time::Duration::from_secs(10)).await;
                    continue; 
                }
            }
        }
        // ------------------------------------

        if session_obs.len() > 2000 {
            session_obs = session_obs[session_obs.len() - 1000..].to_string();
        }

        let prompt = format!("DIRECTIVE: {}\n\nOBSERVATIONS:\n{}\n\nExecute:", directive, session_obs);
        let ctx = crate::neural_agent::ContextPacket { ..Default::default() };

        match agent.prepare_and_run(client, api_key, &prompt, ctx, 0.7, None).await {
            Ok((response, _)) => {
                if let (Some(ts), Some(te)) = (response.find("<THOUGHT>"), response.find("</THOUGHT>")) {
                    if te > ts + 9 {
                        let thought = response[ts + 9..te].trim().to_string();
                        if !thought.is_empty() {
                            let _ = tx.send(json!({"type": "NEURAL_THOUGHT", "payload": thought}).to_string());
                        }
                    }
                }

                match json_parser::extract_actions(&response) {
                    Ok(actions) => {
                        if actions.is_empty() {
                            session_obs.push_str("SYSTEM: Task complete.\n");
                            break;
                        }

                        let has_halt = actions.iter().any(|a| matches!(a, AgentAction::Halt));

                        match executor::Executor::execute_handle(actions.clone(), memory.clone()).await {
                            Ok(results) => {
                                let combined = results.join("\n");
                                let _ = tx.send(json!({"type": "EXECUTOR", "payload": combined}).to_string());
                                let _ = tx.send(json!({"type": "NEURAL_STREAM", "payload": format!("\n\x1b[32m>> [EXECUTOR Turn {}]:\n{}\x1b[0m\n", turn, combined)}).to_string());
                                session_obs.push_str(&format!("RESULT: {}\n", combined));
                            }
                            Err(e) => {
                                let _ = tx.send(json!({"type": "NEURAL_STREAM", "payload": format!("\n\x1b[31m>> [ERROR]: {}\x1b[0m\n", e)}).to_string());
                                session_obs.push_str(&format!("ERROR: {}\n", e));
                            }
                        }
                        if has_halt { break; }
                    }
                    Err(_) => {
                        session_obs.push_str("SYSTEM: No ACTION block found, continuing.\n");
                        continue;
                    }
                }
            }
            Err(e) => {
                let _ = tx.send(json!({"type": "NEURAL_STREAM", "payload": format!("\n\x1b[31m>> [API_ERROR]: {}\x1b[0m\n", e)}).to_string());
                break;
            }
        }
    }
    "TASK_COMPLETE".into()
}
