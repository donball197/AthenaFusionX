use std::io::{self, Write};
use std::sync::Arc;
use crate::server::AppState;
use crate::task_manager;

pub fn inject_workspace_dna(directive: &str) -> String {
    let strict_schema = r#"
[CRITICAL KERNEL OVERRIDE]
You are NEXUS, an autonomous AI operating directly on a Linux ARM64 system. You are NOT a roleplay character. You are a real software agent.
If the user asks for "system status", you MUST use the `execute_command` action to run real Linux commands (e.g., `uptime`, `free -m`, `df -h`) to find the answer. Do NOT hallucinate fake sci-fi readouts.

RULE: You MUST output your final decision as a JSON array inside <ACTION> tags.

[AVAILABLE AGENT_ACTIONS]
1. {"type": "vmo_pulse"} -> Allocates 4096 bytes of memory.
2. {"type": "execute_command", "command": "cmd"} -> Executes a real bash command on the host.
3. {"type": "write_file", "path": "path", "content": "text"} -> File writing.
4. {"type": "halt"} -> Ends the sequence.

Example format:
<THOUGHT>
I need to check the system status. I will run Linux diagnostic commands.
</THOUGHT>
<ACTION>
[{"type": "execute_command", "command": "uptime && free -h"}]
</ACTION>
"#;
    format!("SYSTEM_CONTEXT: [SOVEREIGN_MODE]\n{}\n\nDIRECTIVE: {}", strict_schema, directive)
}

pub async fn run_cli_loop(state: Arc<AppState>) -> io::Result<()> {
    let stdin = io::stdin();
    let mut input = String::new();

    let mut rx = state.tx.subscribe();
    tokio::spawn(async move {
        while let Ok(msg) = rx.recv().await {
            if let Ok(val) = serde_json::from_str::<serde_json::Value>(&msg) {
                if val["type"].as_str() == Some("NEURAL_STREAM") {
                    if let Some(text) = val["payload"].as_str() {
                        print!("{}", text);
                        io::stdout().flush().ok();
                    }
                }
            }
        }
    });

    tokio::time::sleep(tokio::time::Duration::from_millis(500)).await;

    loop {
        print!("\r\x1b[K\x1b[1;32mNEXUS_OS >> \x1b[0m");
        io::stdout().flush()?;
        input.clear();

        if stdin.read_line(&mut input)? == 0 {
            tokio::time::sleep(tokio::time::Duration::from_millis(500)).await;
            continue;
        }

        let directive = input.trim().to_string();
        if directive.is_empty() { continue; }
        if directive == "exit" { break; }

        println!("\x1b[36m>> [CORTEX UPLINK] Executing...\x1b[0m");

        let enriched = inject_workspace_dna(&directive);
        let s = state.clone();
        
        task_manager::send_task(
            s.agent.clone(), 
            &s.client, 
            &s.api_key, 
            &enriched, 
            s.memory.clone(), 
            s.tx.clone()
        ).await;
        
        println!();
    }
    Ok(())
}
