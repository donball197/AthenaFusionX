// src/swarm/consensus.rs
// NEXUS Swarm Consensus Suite
// Qualitative (Voter) + Quantitative (Average) Integration

use std::collections::HashMap;

// --- PART 1: QUALITATIVE CONSENSUS (Response Voting) ---

pub struct ConsensusEngine;

impl ConsensusEngine {
    pub fn resolve(responses: Vec<String>) -> String {
        if responses.is_empty() { return "NO_CONSENSUS".to_string(); }
        let mut score: HashMap<String, usize> = HashMap::new();

        for r in &responses {
            let core_action = if let (Some(s), Some(e)) = (r.find("<ACTION>"), r.find("</ACTION>")) {
                r[s + 8..e].trim().to_string()
            } else {
                r.clone()
            };
            let normalized = core_action.to_lowercase();
            *score.entry(normalized).or_insert(0) += 1;
        }

        let best_action_str = score.into_iter()
            .max_by_key(|(_, count)| *count)
            .map(|(action, _)| action)
            .unwrap_or_else(|| "[]".to_string());

        for r in responses {
            if r.to_lowercase().contains(&best_action_str) { return r; }
        }

        format!("<THOUGHT>\nConsensus achieved.\n</THOUGHT>\n<ACTION>\n{}\n</ACTION>", best_action_str)
    }
}

// --- PART 2: QUANTITATIVE CONSENSUS (Average Consensus) ---

#[derive(Debug, Clone)]
pub struct SwarmNodeState {
    pub id: &'static str,
    pub local_state: f64,
}

pub struct AverageConsensus {
    pub nodes: Vec<SwarmNodeState>,
}

impl AverageConsensus {
    pub fn new(initial: Vec<(&'static str, f64)>) -> Self {
        Self {
            nodes: initial.into_iter()
                .map(|(id, val)| SwarmNodeState { id, local_state: val })
                .collect(),
        }
    }

    pub fn iterate(&mut self, epsilon: f64) {
        let old: Vec<f64> = self.nodes.iter().map(|n| n.local_state).collect();
        for (i, node) in self.nodes.iter_mut().enumerate() {
            let mut delta = 0.0;
            for (j, &val) in old.iter().enumerate() {
                if i != j { delta += val - old[i]; }
            }
            node.local_state += epsilon * delta;
        }
    }

    pub fn converge(&mut self, epsilon: f64, max_iters: usize) {
        for _ in 0..max_iters {
            let prev_states: Vec<f64> = self.nodes.iter().map(|n| n.local_state).collect();
            self.iterate(epsilon);
            let converged = self.nodes.iter().zip(prev_states.iter())
                .all(|(n, p)| (n.local_state - p).abs() < 1e-6);
            if converged { break; }
        }
    }

    pub fn persist_to_vmo(&self, handle: u32) {
        let data = format!("AVG_STATE:{:.4}", self.nodes[0].local_state);
        println!("\x1b[36m[RESONANCE] Persisting Swarm State to VMO 0x{:x}: {}\x1b[0m", handle, data);
    }
}
