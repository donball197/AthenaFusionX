use crate::model_config;

pub struct AgentFactory;

impl AgentFactory {
    pub fn new() -> Self {
        Self
    }

    pub fn get_model_for_turn(turn: usize, error_count: usize) -> String {
        if error_count > 0 {
            return model_config::get_model();
        }
        match turn {
            0..=4 => model_config::get_light_models()
                .first()
                .unwrap_or(&"gemini-3.1-flash-lite".to_string())
                .clone(),
            _ => model_config::get_heavy_models()
                .first()
                .unwrap_or(&"gemma-4-31b-it".to_string())
                .clone(),
        }
    }

    pub fn failover_model(_current_model: &str) -> String {
        model_config::get_model()
    }
}

impl Default for AgentFactory {
    fn default() -> Self {
        Self::new()
    }
}
