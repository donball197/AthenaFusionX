use axum::{
    extract::{State, Query, Request, ws::{Message, WebSocket, WebSocketUpgrade}},
    http::StatusCode,
    middleware::{self, Next},
    response::{IntoResponse, Response},
    routing::{get, post},
    Json, Router, body::Bytes,
};
use std::sync::Arc;
use tokio::sync::{Mutex, oneshot, broadcast}; 
use std::sync::atomic::{AtomicU32, AtomicBool, Ordering};
use std::fs;
use serde::{Deserialize, Serialize};
use serde_json::json;
use tower_http::{cors::CorsLayer, services::{ServeDir, ServeFile}};
use chrono::Utc;
use tokio_util::io::ReaderStream;

use crate::neural_agent::ContextPacket;
use crate::memory::MemoryPalace;
use crate::system_monitor::SystemMonitor;
use crate::hiram_core::Hiram;
use crate::scheduler::{NexusTask, Domain, TaskPriority};
use crate::broker::KnowledgeBroker;

fn atomic_to_f32(val: u32) -> f32 { f32::from_bits(val) }

pub struct AppState {
    pub client: reqwest::Client,
    pub brain_endpoint: String,
    pub monitor: SystemMonitor,
    pub memory: Arc<Mutex<MemoryPalace>>,
    pub api_key: String,
    pub current_resonance: Arc<AtomicU32>,
    pub hiram: Arc<Mutex<Hiram>>,
    pub tx: broadcast::Sender<String>,
    pub auto_apply: Arc<AtomicBool>,
    pub scheduler_tx: tokio::sync::mpsc::Sender<NexusTask>,
    pub auth_token: String,
    pub orchestrator: Arc<crate::orchestrator::Orchestrator>,
}

#[derive(Deserialize, Serialize, Default)]
pub struct PromptRequest { 
    #[serde(default)] pub prompt: String, 
    pub context: Option<String>, 
    pub terminal_context: Option<String> 
}

#[derive(Serialize)] pub struct NeuralResponse { pub response: String, pub status: String }
#[derive(Serialize)] pub struct VitalsResponse { pub status: String, pub cpu_usage: f32, pub ram_usage: String, pub resonance: f32 }
#[derive(Deserialize)] pub struct FileParams { pub q: Option<String>, pub path: Option<String> }
#[derive(Serialize, Deserialize)] pub struct FileContent { pub path: String, pub content: String, pub author: Option<String> }

pub async fn start_server(state: Arc<AppState>, bind_addr: String) {
    let serve_dir = ServeDir::new("ui/dist").not_found_service(ServeFile::new("ui/dist/index.html"));
    let protected_routes = Router::new()
        .route("/api/terminal", post(crate::server_terminal::terminal_command))
        .route("/api/prompt", post(handle_prompt))
        .route("/api/vitals", get(handle_vitals))
        .route("/api/fs/search", get(handle_fs_search))
        .route("/api/fs/read", get(handle_read_file))
        .route("/api/fs/write", post(handle_write_file))
        .route("/api/healer/toggle", post(toggle_auto_apply))
        .route("/api/security/audit", get(handle_audit_status))
        .route("/api/lazarus/history", get(handle_lazarus_history))
        .route("/api/factory/export", get(handle_factory_export))
        .route("/api/command/execute", post(handle_command_execute))
        .route("/ws/ghost", get(ws_ghost_handler))
        .route_layer(middleware::from_fn_with_state(state.clone(), auth_guard));

    let app = Router::new().merge(protected_routes).fallback_service(serve_dir)
        .route("/api/resonance/feedback", post(resonance_feedback))
        .layer(CorsLayer::permissive()).with_state(state);

    let listener = tokio::net::TcpListener::bind(&bind_addr).await.unwrap();
    tracing::info!(">> [NEXUS] CONTROL ONLINE: http://{}", bind_addr);
    axum::serve(listener, app).await.unwrap();
}

async fn handle_fs_search(Query(params): Query<FileParams>) -> Json<serde_json::Value> {
    let query = params.q.unwrap_or_default().to_lowercase();
    let atlas = KnowledgeBroker::load_atlas();
    let results: Vec<_> = atlas.entries.iter()
        .filter(|e| e.name.to_lowercase().contains(&query) || e.path.to_lowercase().contains(&query))
        .take(15).collect();
    Json(json!({ "results": results }))
}

async fn handle_write_file(State(_state): State<Arc<AppState>>, Json(payload): Json<FileContent>) -> impl IntoResponse {
    if payload.content.len() > 1_048_576 { return (StatusCode::PAYLOAD_TOO_LARGE, "Limit 1MB").into_response(); }
    if let Err(e) = crate::auditor::SyntaxSentinel::validate_safety(&payload.path, &payload.content) {
        return (StatusCode::BAD_REQUEST, format!("SAFETY_BLOCK: {}", e)).into_response();
    }
    let author = payload.author.unwrap_or_else(|| "ARCHITECT".to_string());
    let _ = crate::lazarus_vault::LazarusVault::seal_patch(&payload.path, &payload.content, &author);

    match fs::write(&payload.path, &payload.content) {
        Ok(_) => {
            tokio::spawn(async move { let _ = crate::broker::KnowledgeBroker::refresh_atlas().await; });
            StatusCode::OK.into_response()
        },
        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()).into_response()
    }
}

async fn handle_prompt(State(state): State<Arc<AppState>>, body: Bytes) -> Json<NeuralResponse> {
    let payload: PromptRequest = serde_json::from_slice(&body).unwrap_or_default();
    let lower_prompt = payload.prompt.trim().to_lowercase();

    // --- COMMAND INTERCEPTORS ---
    if lower_prompt.starts_with("/factory start") {
        let s_clone = state.clone();
        tokio::spawn(async move { 
            let _ = s_clone.orchestrator.run_data_factory(&s_clone.client, &s_clone.api_key, 3, &s_clone.tx).await; 
        });
        return Json(NeuralResponse { response: "[ { \"action\": \"Message\", \"message\": \"Kaggle Factory Engaged. Initializing Swarm...\" } ]".into(), status: "200".into() });
    }

    if lower_prompt.contains("reindex") || lower_prompt.contains("refresh atlas") {
        let msg = crate::broker::KnowledgeBroker::refresh_atlas().await.unwrap_or_else(|e| format!("Error: {}", e));
        let safe_msg = msg.replace("\"", "\\\"");
        return Json(NeuralResponse { 
            response: format!("[ {{ \"action\": \"Message\", \"message\": \"Atlas Synchronized.\\n{}\" }} ]", safe_msg), 
            status: "200".into() 
        });
    }

    if lower_prompt.contains("project tree") || lower_prompt.contains("show tree") || lower_prompt.contains("file tree") {
        let tree = crate::polyglot::generate_project_tree();
        let safe_tree = tree.replace("\"", "\\\"").replace("\n", "\\n");
        return Json(NeuralResponse { 
            response: format!("[ {{ \"action\": \"Message\", \"message\": \"Current Project Structure:\\n\\n{}\" }} ]", safe_tree), 
            status: "200".into() 
        });
    }
    
    if lower_prompt.contains("system status") {
        let vitals = state.monitor.get_vital_signs_string();
        let safe_vitals = vitals.replace("\"", "\\\"");
        return Json(NeuralResponse { 
            response: format!("[ {{ \"action\": \"Message\", \"message\": \"System Status:\\n{}\" }} ]", safe_vitals), 
            status: "200".into() 
        });
    }

    let history = crate::lazarus_vault::LazarusVault::list_snapshots().unwrap_or_default();
    let recent = history.iter().rev().take(5).map(|e| format!("[{}] {} by {}", e.timestamp, e.path, e.author)).collect::<Vec<_>>().join("\n");

    let ctx = ContextPacket { 
        system_stats: Some(state.monitor.get_vital_signs_string()), 
        file_content: payload.context, 
        memory_recall: Some(format!("RECENT_HISTORY:\n{}", recent)),
        ..Default::default() 
    };
    
    let (tx, rx) = oneshot::channel();
    let task = NexusTask { id: format!("PROMPT_{}", Utc::now().timestamp()), domain: Domain::Code, priority: TaskPriority::High, payload: payload.prompt, attempt_count: 0, response_tx: Some(tx), context: ctx };
    
    if state.scheduler_tx.send(task).await.is_err() {
        return Json(NeuralResponse { response: "[ { \"action\": \"Message\", \"message\": \"Swarm queue disconnected.\" } ]".into(), status: "fail".into() });
    }
    
    match rx.await {
        Ok(response) => Json(NeuralResponse { response, status: "ok".into() }),
        Err(_) => Json(NeuralResponse { response: "[ { \"action\": \"Message\", \"message\": \"Agent timeout.\" } ]".into(), status: "fail".into() })
    }
}

async fn handle_vitals(State(state): State<Arc<AppState>>) -> Json<VitalsResponse> {
    let v = state.monitor.get_vitals();
    Json(VitalsResponse { status: v.status, cpu_usage: v.cpu_load, ram_usage: format!("{:.2}GB", v.ram_used_gb), resonance: atomic_to_f32(state.current_resonance.load(Ordering::Relaxed)) })
}

async fn handle_read_file(Query(params): Query<FileParams>) -> impl IntoResponse {
    let p = params.path.unwrap_or_default();
    match fs::read_to_string(&p) { 
        Ok(c) => (StatusCode::OK, Json(json!({ "path": p, "content": c }))).into_response(), 
        Err(_) => (StatusCode::NOT_FOUND, "Not found").into_response() 
    }
}

async fn handle_lazarus_history() -> Json<serde_json::Value> {
    let history = crate::lazarus_vault::LazarusVault::list_snapshots().unwrap_or_default();
    Json(json!({ "status": "ok", "history": history }))
}

async fn handle_factory_export() -> impl IntoResponse {
    let output_zip = "nexus_factory_export.zip";
    let _ = std::process::Command::new("zip").args(["-r", "-j", output_zip, ".lazarus/factory"]).status();
    let file = match tokio::fs::File::open(output_zip).await {
        Ok(f) => f,
        Err(_) => return (StatusCode::INTERNAL_SERVER_ERROR, "Export Failed").into_response(),
    };
    let cleanup_path = output_zip.to_string();
    tokio::spawn(async move { tokio::time::sleep(std::time::Duration::from_secs(60)).await; let _ = tokio::fs::remove_file(cleanup_path).await; });
    Response::builder()
        .header("Content-Type", "application/zip")
        .header("Content-Disposition", "attachment; filename=\"factory_data.zip\"")
        .body(axum::body::Body::from_stream(ReaderStream::new(file))).unwrap()
}

async fn handle_command_execute(State(state): State<Arc<AppState>>, Json(payload): Json<serde_json::Value>) -> impl IntoResponse {
    let cmd = payload["command"].as_str().unwrap_or_default();
    match crate::command_executor::execute_allowed_command(&state.monitor, cmd).await {
        Ok(res) => Json(res).into_response(),
        Err(e) => (StatusCode::BAD_REQUEST, e.to_string()).into_response(),
    }
}

async fn auth_guard(State(_state): State<Arc<AppState>>, req: Request, next: Next) -> Result<Response, StatusCode> { Ok(next.run(req).await) }

async fn ws_ghost_handler(ws: WebSocketUpgrade, State(state): State<Arc<AppState>>) -> impl IntoResponse {
    ws.on_upgrade(move |socket| handle_ghost_socket(socket, state))
}

async fn handle_ghost_socket(mut socket: WebSocket, state: Arc<AppState>) {
    let mut rx = state.tx.subscribe();
    while let Ok(msg) = rx.recv().await { if socket.send(Message::Text(msg)).await.is_err() { break; } }
}

pub async fn adjust_resonance(state: &Arc<AppState>, delta: f32, reason: &str) {
    let current = f32::from_bits(state.current_resonance.load(Ordering::Relaxed));
    let new_res = (current + delta).clamp(0.1, 1.0);
    state.current_resonance.store(new_res.to_bits(), Ordering::Relaxed);
    let _ = state.tx.send(json!({"type":"vitals","resonance":new_res,"reason":reason}).to_string());
}

pub async fn resonance_feedback(State(state): State<Arc<AppState>>, Json(payload): Json<serde_json::Value>) -> Json<serde_json::Value> {
    let prompt = payload["prompt"].as_str().unwrap_or("");
    let delta = if prompt.contains("SUCCESS") { 0.06 } else { -0.06 };
    adjust_resonance(&state, delta, "feedback").await;
    Json(json!({ "status": "ok" }))
}

async fn toggle_auto_apply(State(state): State<Arc<AppState>>) -> Json<serde_json::Value> {
    let current = state.auto_apply.load(Ordering::Relaxed);
    state.auto_apply.store(!current, Ordering::Relaxed);
    Json(json!({ "auto_apply": !current }))
}

async fn handle_audit_status(State(_state): State<Arc<AppState>>) -> Json<serde_json::Value> {
    Json(json!({ "status": "clean" }))
}

