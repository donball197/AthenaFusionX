<script>
    import { onDestroy, onMount, createEventDispatcher } from 'svelte';
    import { fade } from 'svelte/transition';

    const dispatch = createEventDispatcher();

    export let logs = "";
    export let isThinking = false;
    export let active = false;
    export let onCommand = (cmd) => {};
    export let version = "v1.0.0 // SWARM_ACTIVE";

    let mode = "NEURAL"; 
    let input = "";
    let ghostLogs = [];            
    let socket;
    
    let liveStreamText = "";
    let isStreaming = false;

    function connectGhost() {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        socket = new WebSocket(`${protocol}//${window.location.host}/ws/ghost`);

        socket.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type === "STREAM_START") {
                    isStreaming = true;
                    liveStreamText = "";
                } else if (data.type === "NEURAL_CHUNK") {
                    liveStreamText += data.token;
                } else if (data.type === "STREAM_END") {
                    isStreaming = false;
                } else if (data.type === "SYSTEM_LOG") {
                    ghostLogs = [...ghostLogs, data.token.trim()].slice(-20);
                }
            } catch (e) {
                ghostLogs = [...ghostLogs, event.data.trim()].slice(-20);
            }
        };

        socket.onclose = () => {
            if (active) setTimeout(connectGhost, 5000); 
        };
    }

    function handleKey(e) {
        if (e.key === 'Enter' && input.trim() && !isThinking) {
            onCommand(input.trim());
            input = "";
            mode = "NEURAL";
            liveStreamText = ""; 
        }
    }

    function handleFilesClick() { dispatch('toggleFiles'); }

    onMount(() => { if (active) connectGhost(); });
    onDestroy(() => { if (socket) socket.close(); });
</script>

